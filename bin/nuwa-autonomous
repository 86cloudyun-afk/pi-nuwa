function log(msg) {
	console.log(`[nuwa-autonomous] ${msg}`);
}

function logErr(msg) {
	console.error(`[nuwa-autonomous] ERROR: ${msg}`);
}

function parsePositiveNumber(name, raw, integerOnly = false) {
	if (String(raw ?? "").trim() === "") {
		throw new Error(`参数 ${name} 必须为正${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	const n = Number(raw);
	if (!Number.isFinite(n) || n <= 0 || (integerOnly && !Number.isInteger(n))) {
		throw new Error(`参数 ${name} 必须为正${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	return n;
}

function parseNonNegativeNumber(name, raw, integerOnly = false) {
	if (String(raw ?? "").trim() === "") {
		throw new Error(`参数 ${name} 必须为非负${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	const n = Number(raw);
	if (!Number.isFinite(n) || n < 0 || (integerOnly && !Number.isInteger(n))) {
		throw new Error(`参数 ${name} 必须为非负${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	return n;
}

function parseEnvNonNegativeNumber(name, fallback, integerOnly = false) {
	const raw = (process.env[name] ?? "").trim();
	if (!raw) return fallback;
	const n = Number(raw);
	if (!Number.isFinite(n) || n < 0 || (integerOnly && !Number.isInteger(n))) {
		return fallback;
	}
	return n;
}

function parseEnvPositiveNumber(name, fallback) {
	const raw = (process.env[name] ?? "").trim();
	if (!raw) return fallback;
	const n = Number(raw);
	if (!Number.isFinite(n) || n <= 0) return fallback;
	return n;
}

function parseArgs(argv) {
	const opts = {
		target: "",
		mode: "ctf",
		modeExplicit: false,
		goal: "",
		root: process.cwd(),
		rootExplicit: false,
		maxGenerations: 20,
		maxHours: 12,
		genTimeoutMinutes: DEFAULT_GEN_TIMEOUT_MINUTES,
		idleTimeoutMinutes: DEFAULT_IDLE_TIMEOUT_MINUTES,
		reincarnateTokens: 140000,
		reincarnateTurns: 30,
		maxTotalTokens: parseEnvNonNegativeNumber("NUWA_MAX_TOTAL_TOKENS", 0, true),
		maxUsd: parseEnvNonNegativeNumber("NUWA_MAX_USD", 0, false),
		usdPer1mTokens: parseEnvPositiveNumber("NUWA_USD_PER_1M_TOKENS", DEFAULT_USD_PER_1M_TOKENS),
		webhook: (process.env.NUWA_WEBHOOK_URL ?? "").trim(),
		allowSubdomains: false,
		allowCidrs: [],
		model: "",
		fastModel: "",
		deepModel: "",
		verifyModel: "",
		sandbox: "none",
		sandboxExplicit: false,
		sandboxImage: "",
		egressProxy: (process.env.NUWA_EGRESS_PROXY ?? "").trim(),
		ompBin: "omp",
		dryRun: false,
		help: false,
	};

	const needVal = (flag, i) => {
		if (i + 1 >= argv.length) throw new Error(`参数 ${flag} 缺少取值`);
		return argv[i + 1];
	};

	for (let i = 0; i < argv.length; i += 1) {
		const raw = argv[i];
		let flag = raw;
		let inlineVal = null;
		if (raw.startsWith("--") && raw.includes("=")) {
			const idx = raw.indexOf("=");
			flag = raw.slice(0, idx);
			inlineVal = raw.slice(idx + 1);
		}
		const take = () => (inlineVal !== null ? inlineVal : needVal(flag, i++));

		switch (flag) {
			case "-h":
			case "--help":
				opts.help = true;
				break;
			case "--target":
				opts.target = take().trim();
				break;
			case "--mode":
				opts.mode = take().trim().toLowerCase();
				opts.modeExplicit = true;
				break;
			case "--goal":
				opts.goal = take().trim();
				break;
			case "--root":
				opts.root = take().trim();
				opts.rootExplicit = true;
				break;
			case "--max-generations":
				opts.maxGenerations = parsePositiveNumber(flag, take(), true);
				break;
			case "--max-hours":
				opts.maxHours = parsePositiveNumber(flag, take(), false);
				break;
			case "--gen-timeout-minutes":
				opts.genTimeoutMinutes = parsePositiveNumber(flag, take(), false);
				break;
			case "--idle-timeout-minutes":
				opts.idleTimeoutMinutes = parseNonNegativeNumber(flag, take(), false);
				break;
			case "--reincarnate-tokens":
				opts.reincarnateTokens = parsePositiveNumber(flag, take(), true);
				break;
			case "--reincarnate-turns":
				opts.reincarnateTurns = parsePositiveNumber(flag, take(), true);
				break;
			case "--max-total-tokens":
				opts.maxTotalTokens = parseNonNegativeNumber(flag, take(), true);
				break;
			case "--max-usd":
				opts.maxUsd = parseNonNegativeNumber(flag, take(), false);
				break;
			case "--usd-per-1m-tokens":
				opts.usdPer1mTokens = parsePositiveNumber(flag, take(), false);
				break;
			case "--webhook":
				opts.webhook = take().trim();
				break;
			case "--allow-subdomains":
				opts.allowSubdomains = true;
				break;
			case "--allow-cidr": {
				const parts = take()
					.split(",")
					.map((s) => s.trim())
					.filter(Boolean);
				for (const c of parts) {
					if (!opts.allowCidrs.includes(c)) opts.allowCidrs.push(c);
				}
				break;
			}
			case "--model":
				opts.model = take().trim();
				break;
			case "--fast-model":
				opts.fastModel = take().trim();
				break;
			case "--deep-model":
				opts.deepModel = take().trim();
				break;
			case "--verify-model":
				opts.verifyModel = take().trim();
				break;
			case "--sandbox":
				opts.sandbox = take().trim().toLowerCase();
				opts.sandboxExplicit = true;
				break;
			case "--sandbox-image":
				opts.sandboxImage = take().trim();
				if (
					!opts.sandboxImage ||
					opts.sandboxImage.includes("..") ||
					!/^[a-zA-Z0-9][a-zA-Z0-9._/:@-]{0,255}$/.test(opts.sandboxImage)
				) {
					throw new Error(`参数 --sandbox-image 取值非法: ${JSON.stringify(opts.sandboxImage)}`);
				}
				break;
			case "--egress-proxy":
				opts.egressProxy = take().trim();
				break;
			case "--omp-bin":
				opts.ompBin = take().trim() || "omp";
				break;
			case "--dry-run":
				opts.dryRun = true;
				break;
			default:
				throw new Error(`未知参数: ${raw}（使用 --help 查看用法）`);
		}
	}

	if (!VALID_MODES.has(opts.mode)) {
		throw new Error(`不支持的 --mode: ${opts.mode}（可选: ${[...VALID_MODES].join(", ")}）`);
	}
	if (!VALID_SANDBOX_MODES.has(opts.sandbox)) {
		throw new Error(`不支持的 --sandbox: ${opts.sandbox}（可选: none, docker, sidecar）`);
	}
	if (!opts.help && opts.webhook) {
		let parsedWebhook;
		try {
			parsedWebhook = new URL(opts.webhook);
		} catch {
			throw new Error(`参数 --webhook 不是合法 URL`);
		}
		if (!["http:", "https:"].includes(parsedWebhook.protocol) || !parsedWebhook.hostname) {
			throw new Error(`参数 --webhook 仅支持 http/https URL`);
		}
	}
	if (!opts.help && opts.egressProxy) {
		let parsedProxy;
		try {
			parsedProxy = new URL(opts.egressProxy);
		} catch {
			throw new Error(`参数 --egress-proxy 不是合法 URL`);
		}
		if (
			!["http:", "https:", "socks4:", "socks4a:", "socks5:", "socks5h:"].includes(parsedProxy.protocol.toLowerCase()) ||
			!parsedProxy.hostname
		) {
			throw new Error(`参数 --egress-proxy 仅支持 http/https/socks 代理 URL`);
		}
	}
	opts.root = resolve(opts.root || process.cwd());
	if (
		!opts.help &&
		!opts.rootExplicit &&
		!existsSync(join(opts.root, ".nuwa", "state.json")) &&
		!existsSync(join(opts.root, ".nuwa", "nuwa.db"))
	) {
		if (isVolatileTempPathDaemon(opts.root) || isSharedRootDaemon(opts.root)) {
			const slugLabel = slugifyDaemon(opts.target || "workspace");
			opts.root = join(resolveDefaultWorkspacesDirDaemon(), slugLabel);
			opts.migratedFromTmp = true;
		}
	}
	return opts;
}

function parseDoctorArgs(argv) {
	const opts = {
		json: false,
		help: false,
		agentHome: "",
		ompBin: (process.env.NUWA_OMP_BIN ?? "").trim() || "omp",
		bunBin: (process.env.NUWA_DOCTOR_BUN_BIN ?? "").trim() || "bun",
		kbDb: "",
		sandbox: "none",
		sandboxImage: (process.env.NUWA_SANDBOX_IMAGE ?? "").trim() || "nuwa-sandbox:latest",
		dockerBin: (process.env.NUWA_DOCKER_BIN ?? "").trim() || "docker",
		ghBin: (process.env.NUWA_GH_BIN ?? "").trim() || "gh",
		ghExplicit: Boolean((process.env.NUWA_GH_BIN ?? "").trim()),
		checkGhAuth: (process.env.NUWA_DOCTOR_CHECK_GH ?? "").trim() === "1",
	};

	const needVal = (flag, i) => {
		if (i + 1 >= argv.length) throw new Error(`参数 ${flag} 缺少取值`);
		return argv[i + 1];
	};

	for (let i = 0; i < argv.length; i += 1) {
		const raw = argv[i];
		let flag = raw;
		let inlineVal = null;
		if (raw.startsWith("--") && raw.includes("=")) {
			const idx = raw.indexOf("=");
			flag = raw.slice(0, idx);
			inlineVal = raw.slice(idx + 1);
		}
		const take = () => (inlineVal !== null ? inlineVal : needVal(flag, i++));

		switch (flag) {
			case "-h":
			case "--help":
				opts.help = true;
				break;
			case "--json":
				opts.json = true;
				break;
			case "--agent-home":
				opts.agentHome = take().trim();
				break;
			case "--omp-bin":
				opts.ompBin = take().trim() || "omp";
				break;
			case "--bun-bin":
				opts.bunBin = take().trim() || "bun";
				break;
			case "--kb-db":
				opts.kbDb = take().trim();
				break;
			case "--sandbox":
				opts.sandbox = take().trim().toLowerCase();
				break;
			case "--sandbox-image":
				opts.sandboxImage = take().trim() || "nuwa-sandbox:latest";
				break;
			case "--docker-bin":
				opts.dockerBin = take().trim() || "docker";
				break;
			case "--gh-bin":
				opts.ghBin = take().trim() || "gh";
				opts.ghExplicit = true;
				break;
			case "--check-gh-auth":
				opts.checkGhAuth = true;
				break;
			default:
				throw new Error(`doctor 未知参数: ${raw}（使用 nuwa-autonomous doctor --help 查看用法）`);
		}
	}

	if (!VALID_SANDBOX_MODES.has(opts.sandbox)) {
		throw new Error(`doctor 不支持的 --sandbox: ${opts.sandbox}（可选: none, docker, sidecar）`);
	}
	return opts;
}

function resolveExecutable(binName) {
	const name = String(binName ?? "").trim();
	if (!name) return null;
	if (name.includes("/") || name.includes("\\")) {
		try {
			const full = resolve(name);
			if (statSync(full).isFile()) {
				accessSync(full, constants.X_OK);
				return full;
			}
		} catch {
			return null;
		}
		return null;
	}
	const pathEnv = process.env.PATH ?? "";
	for (const dir of pathEnv.split(delimiter)) {
		if (!dir) continue;
		const full = join(dir, name);
		try {
			if (statSync(full).isFile()) {
				accessSync(full, constants.X_OK);
				return full;
			}
		} catch {
			/* 继续查找下一 PATH 目录 */
		}
	}
	return null;
}

function getGhHttpTimeoutSec() {
	const raw = (process.env.NUWA_GH_HTTP_TIMEOUT ?? process.env.GH_HTTP_TIMEOUT ?? "").trim();
	const n = Number(raw);
	return Number.isFinite(n) && n > 0 ? Math.floor(n) : DEFAULT_GH_HTTP_TIMEOUT_SEC;
}

function getExternalProbeTimeoutMs(fallbackMs = DEFAULT_EXTERNAL_PROBE_TIMEOUT_MS) {
	const raw = (process.env.NUWA_EXTERNAL_PROBE_TIMEOUT_MS ?? "").trim();
	const n = Number(raw);
	return Number.isFinite(n) && n >= 50 ? Math.floor(n) : fallbackMs;
}

/** 受短超时与 GH_HTTP_TIMEOUT=5 硬保护的外部命令探活，避免 gh/git/docker 等外部 CLI 无限挂死。 */
function runExternalProbe(binPath, args, opts = {}) {
	const timeoutMs =
		typeof opts.timeoutMs === "number" && Number.isFinite(opts.timeoutMs) && opts.timeoutMs > 0
			? Math.floor(opts.timeoutMs)
			: getExternalProbeTimeoutMs();
	const ghSec = String(getGhHttpTimeoutSec());
	const env = {
		...process.env,
		GH_HTTP_TIMEOUT: ghSec,
		GIT_TERMINAL_PROMPT: "0",
		GIT_HTTP_LOW_SPEED_LIMIT: "1",
		GIT_HTTP_LOW_SPEED_TIME: ghSec,
		...(opts.env ?? {}),
	};
	try {
		const res = spawnSync(binPath, args, {
			encoding: "utf8",
			timeout: timeoutMs,
			killSignal: "SIGKILL",
			env,
			stdio: ["ignore", "pipe", "pipe"],
		});
		const timedOut =
			Boolean(res.error && (res.error.code === "ETIMEDOUT" || /timed out|ETIMEDOUT/i.test(String(res.error.message ?? "")))) ||
			(res.status === null && res.signal === "SIGKILL");
		return {
			ok: !res.error && !timedOut && res.status === 0,
			timedOut,
			status: res.status,
			signal: res.signal,
			stdout: String(res.stdout ?? ""),
			stderr: String(res.stderr ?? ""),
			error: res.error ? String(res.error.message ?? res.error) : "",
			timeoutMs,
		};
	} catch (err) {
		return {
			ok: false,
			timedOut: false,
			status: -1,
			signal: null,
			stdout: "",
			stderr: "",
			error: err instanceof Error ? err.message : String(err),
			timeoutMs,
		};
	}
}

function probeBinaryVersion(binPath, versionArgs = ["--version"]) {
	const res = runExternalProbe(binPath, versionArgs, { timeoutMs: Math.min(3000, getExternalProbeTimeoutMs(3000)) });
	if (res.timedOut || res.error) return null;
	const out = `${res.stdout}\n${res.stderr}`
		.split("\n")
		.map((s) => s.trim())
		.find(Boolean);
	return out || null;
}

function checkGhCliProbe(ghBin, checkAuth = false) {
	const binPath = resolveExecutable(ghBin);
	const ghHttpTimeoutSec = getGhHttpTimeoutSec();
	const timeoutMs = getExternalProbeTimeoutMs(DEFAULT_EXTERNAL_PROBE_TIMEOUT_MS);
	if (!binPath) {
		return {
			ok: true,
			critical: false,
			available: false,
			timedOut: false,
			ghHttpTimeoutSec,
			timeoutMs,
			bin: ghBin,
			reason: "未安装 gh（可选工具，不影响女娲核心运行）",
		};
	}
	const probeArgs = checkAuth ? ["auth", "status"] : ["--version"];
	const res = runExternalProbe(binPath, probeArgs, { timeoutMs: checkAuth ? timeoutMs : Math.min(2000, timeoutMs) });
	if (res.timedOut) {
		return {
			ok: false,
			critical: false,
			available: true,
			timedOut: true,
			ghHttpTimeoutSec,
			timeoutMs,
			bin: binPath,
			reason: `gh 探活超时（已按 ${timeoutMs}ms / GH_HTTP_TIMEOUT=${ghHttpTimeoutSec}s 保护截断，避免挂死）`,
		};
	}
	return {
		ok: true,
		critical: false,
		available: true,
		timedOut: false,
		...(checkAuth ? { authenticated: res.ok } : {}),
		ghHttpTimeoutSec,
		timeoutMs,
		bin: binPath,
		...(res.ok ? {} : { reason: checkAuth ? "gh 已安装但未登录（已快速返回，未阻塞）" : "gh 版本探测返回非零（已快速返回）" }),
	};
}

function resolveAgentHome(overrideDir) {
	if (overrideDir && overrideDir.trim()) {
		return resolve(overrideDir.trim());
	}
	if (process.env.PI_AGENT_HOME && process.env.PI_AGENT_HOME.trim()) {
		return resolve(process.env.PI_AGENT_HOME.trim());
	}
	const ompAgent = join(homedir(), ".omp", "agent");
	if (existsSync(ompAgent)) return ompAgent;
	return join(homedir(), ".pi", "agent");
}

function checkExtensionInstallation(agentHome) {
	const extRoot = join(agentHome, "extensions");
	const extDir = join(extRoot, "nuwa-omp");
	const indexPath = join(extDir, "index.ts");
	const indexExists = existsSync(indexPath);

	let indexSrc = "";
	let version = null;
	if (indexExists) {
		try {
			indexSrc = readFileSync(indexPath, "utf8");
			const m = /export\s+const\s+VERSION\s*=\s*["']([^"']+)["']/.exec(indexSrc);
			if (m?.[1]) version = m[1];
		} catch {
			/* 无法读取 index.ts */
		}
	}

	const toolsFound = [];
	const toolsMissing = [];
	for (const tool of REQUIRED_NUWA_TOOLS) {
		const re = new RegExp(`name\\s*:\\s*["']${tool}["']`);
		if (indexSrc && re.test(indexSrc)) {
			toolsFound.push(tool);
		} else {
			toolsMissing.push(tool);
		}
	}

	const referencesSplitModules =
		/from\s+["']\.\/(?:storage|graph)(?:\.ts)?["']/.test(indexSrc) ||
		/require\s*\(\s*["']\.\/(?:storage|graph)(?:\.ts)?["']\s*\)/.test(indexSrc);
	const hasAnySplitFile = existsSync(join(extDir, "storage.ts")) || existsSync(join(extDir, "graph.ts"));
	const isLegacyMonolith =
		!referencesSplitModules &&
		!hasAnySplitFile &&
		typeof version === "string" &&
		(version === "4.0.0" || /^3\./.test(version));

	const coreModulesFound = [];
	const coreModulesMissing = [];
	for (const mod of CORE_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			coreModulesFound.push(mod);
		} else if (!isLegacyMonolith || !SPLIT_CORE_MODULES.has(mod)) {
			coreModulesMissing.push(mod);
		}
	}

	const v4ModulesFound = [];
	const v4ModulesMissing = [];
	for (const mod of V4_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			v4ModulesFound.push(mod);
		} else {
			v4ModulesMissing.push(mod);
		}
	}

	const v5ModulesFound = [];
	const v5ModulesMissing = [];
	for (const mod of V5_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			v5ModulesFound.push(mod);
		} else {
			v5ModulesMissing.push(mod);
		}
	}

	const v6ModulesFound = [];
	const v6ModulesMissing = [];
	for (const mod of V6_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			v6ModulesFound.push(mod);
		} else {
			v6ModulesMissing.push(mod);
		}
	}

	const conflicts = [];
	if (existsSync(extRoot)) {
		try {
			for (const entry of readdirSync(extRoot)) {
				if (entry.startsWith("nuwa-") && entry !== "nuwa-omp") {
					conflicts.push(entry);
				}
			}
		} catch {
			/* ignore */
		}
	}

	const ok = indexExists && toolsMissing.length === 0 && coreModulesMissing.length === 0;
	let reason = "";
	if (!indexExists) {
		reason = `未检测到已安装扩展入口 ${indexPath}（请运行 ./install.sh）`;
	} else if (toolsMissing.length > 0) {
		reason = `扩展缺少必需工具 (${toolsMissing.join(", ")})`;
	} else if (coreModulesMissing.length > 0) {
		reason = `扩展缺少核心模块 (${coreModulesMissing.join(", ")})`;
	}

	return {
		ok,
		critical: true,
		dir: extDir,
		indexExists,
		version,
		toolsCount: toolsFound.length,
		toolsRequired: REQUIRED_NUWA_TOOLS.length,
		toolsFound,
		toolsMissing,
		coreModulesFound,
		coreModulesMissing,
		v4ModulesFound,
		v4ModulesMissing,
		v5ModulesFound,
		v5ModulesMissing,
		v6ModulesFound,
		v6ModulesMissing,
		conflicts,
		...(reason ? { reason } : {}),
	};
}

function openReadonlySqliteMemorySnapDaemon(filePath) {
	const raw = readFileSync(filePath);
	const copy = new Uint8Array(raw.length);
	copy.set(raw);
	if (
		copy.length >= 100 &&
		Buffer.from(copy.subarray(0, 16)).toString("latin1") === "SQLite format 3\0" &&
		copy[18] === 2 &&
		copy[19] === 2
	) {
		copy[18] = 1;
		copy[19] = 1;
	}
	return Database.deserialize(copy, { readonly: true });
}

function openReadonlyWalIsolatedSnapDaemon(filePath) {
	const snapDir = mkdtempSync(join(tmpdir(), "nuwa-daemon-ro-"));
	const snapDb = join(snapDir, "snap.db");
	try {
		copyFileSync(filePath, snapDb);
		if (existsSync(`${filePath}-wal`)) copyFileSync(`${filePath}-wal`, `${snapDb}-wal`);
		if (existsSync(`${filePath}-shm`)) copyFileSync(`${filePath}-shm`, `${snapDb}-shm`);
		const rwSnap = new Database(snapDb, { readwrite: true });
		try {
			rwSnap.exec("PRAGMA busy_timeout = 3000;");
			rwSnap.exec("PRAGMA wal_checkpoint(TRUNCATE);");
			rwSnap.exec("PRAGMA journal_mode = DELETE;");
		} finally {
			rwSnap.close();
		}
		return openReadonlySqliteMemorySnapDaemon(snapDb);
	} finally {
		try {
			rmSync(snapDir, { recursive: true, force: true });
		} catch {
			/* ignore */
		}
	}
}

function openReadonlyKbDb(filePath) {
	const walFile = `${filePath}-wal`;
	let walNonEmpty = false;
	try {
		walNonEmpty = existsSync(walFile) && statSync(walFile).size > 0;
	} catch {
		walNonEmpty = false;
	}
	if (!walNonEmpty || !existsSync(`${filePath}-shm`)) {
		try {
			const memDb = walNonEmpty
				? openReadonlyWalIsolatedSnapDaemon(filePath)
				: openReadonlySqliteMemorySnapDaemon(filePath);
			memDb.query("SELECT 1 FROM sqlite_master LIMIT 1").get();
			return memDb;
		} catch {
			/* ignore */
		}
	}

	let roDb = null;
	try {
		roDb = new Database(filePath, { readonly: true });
		try {
			roDb.exec("PRAGMA busy_timeout = 3000;");
			roDb.exec("PRAGMA query_only = ON;");
		} catch {
			/* ignore */
		}
		roDb.query("SELECT 1 FROM sqlite_master LIMIT 1").get();
		return roDb;
	} catch {
		try {
			roDb?.close();
		} catch {
			/* ignore */
		}
	}

	// 严格零磁盘写入降级：绝不对原路径以可写模式打开，转在隔离 tmp 目录重放 WAL 后内存只读打开
	const isoDb = openReadonlyWalIsolatedSnapDaemon(filePath);
	isoDb.query("SELECT 1 FROM sqlite_master LIMIT 1").get();
	return isoDb;
}

function checkKnowledgeBase(agentHome, explicitPath, explicitAgentHome = false) {
	const candidates = [];
	if (explicitPath && explicitPath.trim()) {
		candidates.push(resolve(explicitPath.trim()));
	} else if (process.env.NUWA_KB_DB && process.env.NUWA_KB_DB.trim()) {
		candidates.push(resolve(process.env.NUWA_KB_DB.trim()));
		if (explicitAgentHome) {
			candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
		}
	} else if (explicitAgentHome || (process.env.PI_AGENT_HOME && process.env.PI_AGENT_HOME.trim())) {
		candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
	} else {
		candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
		candidates.push("/data/nuwa-kb/kb.db");
	}

	const foundPath = candidates.find((p) => existsSync(p)) ?? candidates[0];
	const exists = existsSync(foundPath);

	if (!exists) {
		return {
			ok: false,
			critical: false,
			path: foundPath,
			exists: false,
			counts: {},
			totalRecords: 0,
			reason: `未找到知识库文件 ${foundPath}`,
		};
	}

	const counts = {};
	let totalRecords = 0;
	let db = null;
	try {
		db = openReadonlyKbDb(foundPath);
		const existingTables = new Set(
			db
				.query("SELECT name FROM sqlite_master WHERE type IN ('table', 'view')")
				.all()
				.map((r) => String(r?.name ?? "")),
		);
		for (const table of KB_TABLES) {
			if (!existingTables.has(table)) continue;
			const row = db.query(`SELECT COUNT(*) AS cnt FROM "${table}"`).get();
			const cnt = Number(row?.cnt ?? 0);
			if (Number.isFinite(cnt)) {
				counts[table] = cnt;
				totalRecords += cnt;
			}
		}
		return {
			ok: totalRecords > 0,
			critical: false,
			path: foundPath,
			exists: true,
			counts,
			totalRecords,
			...(totalRecords === 0 ? { reason: "知识库文件存在但尚无有效记录" } : {}),
		};
	} catch (err) {
		return {
			ok: false,
			critical: false,
			path: foundPath,
			exists: true,
			counts,
			totalRecords: 0,
			reason: `读取知识库失败: ${err instanceof Error ? err.message : String(err)}`,
		};
	} finally {
		try {
			db?.close();
		} catch {
			/* ignore */
		}
	}
}

function checkAgentTemplates(agentHome) {
	const agentsDir = join(agentHome, "agents");
	const checkOne = (filename) => {
		const full = join(agentsDir, filename);
		let exists = false;
		let bytes = 0;
		try {
			const st = statSync(full);
			exists = st.isFile() && st.size > 0;
			bytes = st.size;
		} catch {
			exists = false;
		}
		return { exists, path: full, bytes };
	};

	const fujiang = checkOne("fujiang.md");
	const nuwaVerifier = checkOne("nuwa-verifier.md");
	const missing = [];
	if (!fujiang.exists) missing.push("fujiang.md");
	if (!nuwaVerifier.exists) missing.push("nuwa-verifier.md");

	return {
		ok: missing.length === 0,
		critical: false,
		dir: agentsDir,
		fujiang,
		nuwaVerifier,
		missing,
		...(missing.length > 0 ? { reason: `缺少子代理模板: ${missing.join(", ")}` } : {}),
	};
}

function checkToolchain() {
	const available = [];
	const missing = [];
	for (const tool of DOCTOR_PROBE_TOOLS) {
		if (resolveExecutable(tool)) {
			available.push(tool);
		} else {
			missing.push(tool);
		}
	}
	const hasBasic = available.includes("curl") || available.includes("python3");
	return {
		ok: hasBasic,
		critical: false,
		available,
		missing,
		...(hasBasic ? {} : { reason: "缺少基础网络/脚本工具 curl 与 python3" }),
	};
}

function checkDockerSandbox(dockerBin, image, critical) {
	const binPath = resolveExecutable(dockerBin);
	if (!binPath) {
		return {
			ok: false,
			critical,
			available: false,
			daemonRunning: false,
			image,
			imagePresent: false,
			dockerBin,
			reason: `未找到 Docker 可执行文件: ${dockerBin}`,
		};
	}

	try {
		const info = spawnSync(binPath, ["info", "--format", "{{.ServerVersion}}"], {
			encoding: "utf8",
			timeout: 3000,
			stdio: ["ignore", "pipe", "pipe"],
		});
		if (info.error || info.status !== 0) {
			const msg = info.error?.message || (info.stderr ?? "").trim() || `docker info 退出码 ${info.status}`;
			return {
				ok: false,
				critical,
				available: false,
				daemonRunning: false,
				image,
				imagePresent: false,
				dockerBin: binPath,
				reason: msg,
			};
		}

		const serverVersion = (info.stdout ?? "").trim() || undefined;
		const inspect = spawnSync(binPath, ["image", "inspect", image], {
			encoding: "utf8",
			timeout: 3000,
			stdio: ["ignore", "pipe", "pipe"],
		});
		const imagePresent = !inspect.error && inspect.status === 0;
		const ok = imagePresent;

		return {
			ok,
			critical,
			available: true,
			daemonRunning: true,
			image,
			imagePresent,
			dockerBin: binPath,
			...(serverVersion ? { serverVersion } : {}),
			...(!imagePresent ? { reason: `Docker 运行中但本地缺少沙盒镜像 ${image}` } : {}),
		};
	} catch (err) {
		return {
			ok: false,
			critical,
			available: false,
			daemonRunning: false,
			image,
			imagePresent: false,
			dockerBin: binPath,
			reason: err instanceof Error ? err.message : String(err),
		};
	}
}

function runDoctor(argv) {
	let opts;
	try {
		opts = parseDoctorArgs(argv);
	} catch (err) {
		logErr(err instanceof Error ? err.message : String(err));
		process.exit(2);
	}

	if (opts.help) {
		console.log(DOCTOR_HELP_TEXT.trimEnd());
		process.exit(0);
	}

	const agentHome = resolveAgentHome(opts.agentHome);

	// 1. 检查 bun
	const bunExplicit = opts.bunBin !== "bun";
	const bunPath = resolveExecutable(opts.bunBin) ?? (!bunExplicit ? process.execPath : null);
	const bunVersion = bunPath
		? !bunExplicit && typeof Bun !== "undefined"
			? Bun.version
			: probeBinaryVersion(bunPath, ["--version"])
		: null;
	const bunCheck = {
		ok: Boolean(bunPath),
		critical: true,
		bin: opts.bunBin,
		path: bunPath,
		version: bunVersion,
		...(!bunPath ? { reason: `未找到 bun 可执行文件: ${opts.bunBin}` } : {}),
	};

	// 2. 检查 omp
	const ompPath = resolveExecutable(opts.ompBin);
	const ompVersion = ompPath ? probeBinaryVersion(ompPath, ["--version"]) : null;
	const ompCheck = {
		ok: Boolean(ompPath),
		critical: true,
		bin: opts.ompBin,
		path: ompPath,
		version: ompVersion,
		...(!ompPath ? { reason: `未找到 omp 可执行文件: ${opts.ompBin}` } : {}),
	};

	// 3. 检查 12 工具与扩展模块
	const extensionCheck = checkExtensionInstallation(agentHome);

	// 4. 检查 KB 数据库与记录数
	const kbCheck = checkKnowledgeBase(agentHome, opts.kbDb, Boolean(opts.agentHome));

	// 5. 检查子代理模板 fujiang.md / nuwa-verifier.md
	const agentsCheck = checkAgentTemplates(agentHome);

	// 6. 检查本地工具链
	const toolchainCheck = checkToolchain();

	// 7. 检查 Docker 沙盒可用性
	const dockerCheck = checkDockerSandbox(opts.dockerBin, opts.sandboxImage, opts.sandbox === "docker" || opts.sandbox === "sidecar");

	// 8. 短超时安全探活 gh CLI（防挂死 80s；默认本地快速探测，指定 --gh-bin / --check-gh-auth 时受短超时保护探活 auth status）
	const ghCheck = checkGhCliProbe(opts.ghBin, Boolean(opts.ghExplicit || opts.checkGhAuth));

	const checks = {
		bun: bunCheck,
		omp: ompCheck,
		extension: extensionCheck,
		kb: kbCheck,
		agents: agentsCheck,
		toolchain: toolchainCheck,
		docker: dockerCheck,
		gh: ghCheck,
	};

	const allEntries = Object.entries(checks);
	const criticalEntries = allEntries.filter(([, c]) => c.critical);
	const criticalPassed = criticalEntries.filter(([, c]) => c.ok).length;
	const criticalFailed = criticalEntries.filter(([, c]) => !c.ok).map(([k]) => k);
	const warnings = [];

	if (extensionCheck.conflicts.length > 0) {
		warnings.push(`检测到冲突扩展目录: ${extensionCheck.conflicts.join(", ")}`);
	}
	for (const [name, c] of allEntries) {
		if (!c.critical && !c.ok && c.reason) {
			warnings.push(`${name}: ${c.reason}`);
		}
	}

	const overallOk = criticalFailed.length === 0;
	const exitCode = overallOk ? 0 : 1;

	const report = {
		ok: overallOk,
		exitCode,
		checkedAt: new Date().toISOString(),
		agentHome,
		checks,
		summary: {
			criticalPassed,
			criticalTotal: criticalEntries.length,
			criticalFailed,
			warnings,
		},
	};

	if (opts.json) {
		console.log(JSON.stringify(report, null, 2));
		process.exit(exitCode);
	}

	const badge = (c) => (c.ok ? "[OK]" : c.critical ? "[FAIL]" : "[WARN]");
	const lines = [
		`女娲环境健康体检 (nuwa-autonomous doctor)`,
		`Agent Home: ${agentHome}`,
		`------------------------------------------------------------`,
		`${badge(bunCheck)} bun: ${bunCheck.ok ? `${bunCheck.version ?? "ok"} (${bunCheck.path})` : bunCheck.reason}`,
		`${badge(ompCheck)} omp: ${ompCheck.ok ? `${ompCheck.version ?? "ok"} (${ompCheck.path})` : ompCheck.reason}`,
		`${badge(extensionCheck)} 扩展与工具: ${
			extensionCheck.ok
				? `v${extensionCheck.version ?? "?"} · 工具 ${extensionCheck.toolsCount}/${extensionCheck.toolsRequired} · 核心模块 ${extensionCheck.coreModulesFound.length}/${extensionCheck.coreModulesFound.length + extensionCheck.coreModulesMissing.length} · v4模块 ${extensionCheck.v4ModulesFound.length}/${V4_EXT_MODULES.length} · v5模块 ${extensionCheck.v5ModulesFound.length}/${V5_EXT_MODULES.length}`
				: extensionCheck.reason
		}`,
		`${badge(kbCheck)} 知识库 KB: ${
			kbCheck.exists
				? `${kbCheck.path} (总记录 ${kbCheck.totalRecords}；${Object.entries(kbCheck.counts)
						.map(([k, v]) => `${k}=${v}`)
						.join(", ") || "无表"})`
				: kbCheck.reason
		}`,
		`${badge(agentsCheck)} 子代理模板: fujiang.md=${agentsCheck.fujiang.exists ? "就绪" : "缺失"}, nuwa-verifier.md=${agentsCheck.nuwaVerifier.exists ? "就绪" : "缺失"} (${agentsCheck.dir})`,
		`${badge(toolchainCheck)} 本地工具链: 可用 ${toolchainCheck.available.length}/${DOCTOR_PROBE_TOOLS.length} (${toolchainCheck.available.join(", ") || "无"})${
			toolchainCheck.missing.length ? ` | 缺失: ${toolchainCheck.missing.join(", ")}` : ""
		}`,
		`${badge(dockerCheck)} Docker 沙盒: ${
			dockerCheck.ok
				? `就绪 (daemon ${dockerCheck.serverVersion ?? "ok"}, 镜像 ${dockerCheck.image})`
				: dockerCheck.reason
		}`,
		`------------------------------------------------------------`,
		overallOk
			? `体检结论: 核心依赖就绪 (${criticalPassed}/${criticalEntries.length})${warnings.length ? `，存在 ${warnings.length} 项非阻断提醒` : ""}。`
			: `体检结论: 缺失核心依赖 (${criticalFailed.join(", ")})，请先修复后再运行。`,
	];
	console.log(lines.join("\n"));
	process.exit(exitCode);
}

function stateFilePath(root) {
	return join(root, ".nuwa", "state.json");
}

function reportFilePath(root) {
	return join(root, ".nuwa", "REPORT.md");
}

function slugifyDaemon(raw) {
	return (
		String(raw ?? "")
			.toLowerCase()
			.replace(/^https?:\/\//i, "")
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-+|-+$/g, "")
			.slice(0, 48) || "workspace"
	);
}

function resolvePersistentStateDirDaemon() {
	const explicit = (process.env.NUWA_STATE_DIR ?? "").trim();
	if (explicit) return resolve(explicit);
	const xdg = (process.env.XDG_STATE_HOME ?? "").trim();
	if (xdg) return join(resolve(xdg), "nuwa");
	return join(homedir(), ".local", "state", "nuwa");
}

function resolveDefaultWorkspacesDirDaemon() {
	const explicitWs = (process.env.NUWA_WORKSPACES_DIR ?? "").trim();
	if (explicitWs) return resolve(explicitWs);
	const explicitState = (process.env.NUWA_STATE_DIR ?? "").trim();
	if (explicitState) return join(resolve(explicitState), "workspaces");
	const envAgentHome = (process.env.PI_AGENT_HOME ?? "").trim();
	if (envAgentHome) return join(resolve(envAgentHome), "workspaces");
	return join(resolvePersistentStateDirDaemon(), "workspaces");
}

function isSubpathOrEqualDaemon(candidate, base) {
	const c = resolve(candidate);
	const b = resolve(base);
	if (c === b) return true;
	const prefix = b.endsWith("/") ? b : `${b}/`;
	return c.startsWith(prefix);
}

function isVolatileTempPathDaemon(dirPath) {
	const raw = String(dirPath ?? "").trim();
	if (!raw) return false;
	const cands = new Set([resolve(raw)]);
	try {
		cands.add(realpathSync(raw));
	} catch {
		/* 目录可能尚不存在 */
	}
	const bases = new Set([resolve("/tmp"), resolve("/private/tmp"), resolve("/var/tmp"), resolve("/private/var/tmp"), resolve(tmpdir())]);
	try {
		bases.add(realpathSync(tmpdir()));
	} catch {
		/* ignore */
	}
	for (const cand of cands) {
		for (const base of bases) {
			if (isSubpathOrEqualDaemon(cand, base)) return true;
		}
	}
	return false;
}

function isSharedRootDaemon(dirPath) {
	const r = resolve(dirPath || process.cwd());
	return [resolve("/"), resolve(homedir()), resolve("/tmp"), resolve("/private/tmp"), resolve(tmpdir()), resolve("/data/workspace")].includes(r);
}

function isDaemonTmpWarningSuppressed() {
	const forceWarn = (process.env.NUWA_WARN_TMP_WORKSPACE ?? "").trim().toLowerCase();
	if (forceWarn === "1" || forceWarn === "true") return false;
	const allowTmp = (process.env.NUWA_ALLOW_TMP_WORKSPACE ?? "").trim().toLowerCase();
	if (allowTmp === "1" || allowTmp === "true") return true;
	const nodeEnv = (process.env.NODE_ENV ?? "").trim().toLowerCase();
	if (nodeEnv === "test" || process.env.BUN_TEST === "1" || process.env.NUWA_TEST_MODE === "1") return true;
	return false;
}

function atomicWriteJsonDaemon(filePath, data) {
	mkdirSync(dirname(filePath), { recursive: true });
	const tmp = `${filePath}.tmp-${process.pid}-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
	writeFileSync(tmp, `${JSON.stringify(data, null, 2)}\n`, "utf8");
	renameSync(tmp, filePath);
}

function appendJournalDaemon(root, rec) {
	try {
		const dir = join(root, ".nuwa");
		mkdirSync(dir, { recursive: true });
		appendFileSync(join(dir, "journal.jsonl"), `${JSON.stringify({ ts: new Date().toISOString(), ...rec })}\n`, "utf8");
	} catch {
		/* ignore */
	}
}

function sleepSyncDaemon(ms) {
	if (ms <= 0) return;
	Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Math.floor(ms));
}

function pidAliveDaemon(pid) {
	if (!Number.isInteger(pid) || pid <= 0) return false;
	try {
		process.kill(pid, 0);
		return true;
	} catch {
		return false;
	}
}

function probePgidDaemon(pid) {
	if (!Number.isInteger(pid) || pid <= 0) return null;
	try {
		const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
		const close = stat.lastIndexOf(")");
		if (close >= 0) {
			const fields = stat.slice(close + 2).trim().split(/\s+/);
			const pgid = Number(fields[2]);
			if (Number.isInteger(pgid) && pgid > 0) return pgid;
		}
	} catch {
		/* 非 Linux */
	}
	try {
		const res = spawnSync("ps", ["-o", "pgid=", "-p", String(pid)], {
			encoding: "utf8",
			timeout: 1500,
			stdio: ["ignore", "pipe", "ignore"],
		});
		if (res.status === 0) {
			const pgid = Number(String(res.stdout ?? "").trim());
			if (Number.isInteger(pgid) && pgid > 0) return pgid;
		}
	} catch {
		/* ignore */
	}
	return null;
}

let daemonSelfPgidCached;
function getDaemonSelfPgid() {
	if (daemonSelfPgidCached !== undefined) return daemonSelfPgidCached;
	daemonSelfPgidCached = probePgidDaemon(process.pid);
	return daemonSelfPgidCached;
}

function isSafeDaemonTargetPid(pid) {
	return Number.isInteger(pid) && pid > 1 && pid !== process.pid && pid !== process.ppid;
}

function isSafeDaemonTargetPgid(pgid) {
	if (!Number.isInteger(pgid) || pgid <= 1) return false;
	if (pgid === process.pid || pgid === process.ppid) return false;
	const selfPgid = getDaemonSelfPgid();
	if (selfPgid !== null && pgid === selfPgid) return false;
	return true;
}

function isProcessAliveNonZombieDaemon(pid) {
	if (!pidAliveDaemon(pid)) return false;
	try {
		const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
		const close = stat.lastIndexOf(")");
		if (close >= 0) {
			const st = stat.slice(close + 2).trim()[0] ?? "";
			return st !== "Z" && st !== "X";
		}
	} catch {
		/* 非 Linux */
	}
	try {
		const res = spawnSync("ps", ["-o", "stat=", "-p", String(pid)], {
			encoding: "utf8",
			timeout: 1500,
			stdio: ["ignore", "pipe", "ignore"],
		});
		if (res.status !== 0) return false;
		const st = String(res.stdout ?? "").trim();
		return Boolean(st) && !st.startsWith("Z") && !st.startsWith("X");
	} catch {
		return pidAliveDaemon(pid);
	}
}

function isGroupAliveNonZombieDaemon(pgid, fallbackPid) {
	if (!isSafeDaemonTargetPgid(pgid)) {
		return fallbackPid ? isProcessAliveNonZombieDaemon(fallbackPid) : false;
	}
	let exists = false;
	try {
		process.kill(-pgid, 0);
		exists = true;
	} catch (err) {
		exists = err?.code === "EPERM";
	}
	if (!exists) return fallbackPid ? isProcessAliveNonZombieDaemon(fallbackPid) : false;
	try {
		const res = spawnSync("ps", ["-axo", "pid=,pgid=,stat="], {
			encoding: "utf8",
			timeout: 1500,
			stdio: ["ignore", "pipe", "ignore"],
		});
		if (res.status === 0 && typeof res.stdout === "string" && res.stdout.trim()) {
			for (const line of res.stdout.split("\n")) {
				const parts = line.trim().split(/\s+/);
				if (parts.length < 3) continue;
				if (Number(parts[1]) === pgid && parts[2] && !parts[2].startsWith("Z") && !parts[2].startsWith("X")) {
					return true;
				}
			}
			return false;
		}
	} catch {
		/* ignore */
	}
	return fallbackPid ? isProcessAliveNonZombieDaemon(fallbackPid) : true;
}

function killPidOrGroupSafeDaemon(pid, pgid, signal) {
	if (!isSafeDaemonTargetPid(pid)) return false;
	if (isSafeDaemonTargetPgid(pgid)) {
		try {
			process.kill(-pgid, signal);
			return true;
		} catch (err) {
			if (err?.code === "ESRCH") {
				try {
					process.kill(pid, signal);
					return true;
				} catch {
					return false;
				}
			}
		}
	}
	try {
		process.kill(pid, signal);
		return true;
	} catch {
		return false;
	}
}

function processTrackerPathDaemon(root) {
	return join(root, ".nuwa", "process-groups.json");
}

function readTrackedProcessesDaemon(root) {
	const p = processTrackerPathDaemon(root);
	if (!existsSync(p)) return [];
	try {
		const parsed = JSON.parse(readFileSync(p, "utf8"));
		return Array.isArray(parsed?.records) ? parsed.records : [];
	} catch {
		return [];
	}
}

function registerTrackedProcessDaemon(root, input) {
	const pid = Number(input.pid);
	if (!isSafeDaemonTargetPid(pid)) return null;
	const probed = probePgidDaemon(pid);
	const pgid = Number.isInteger(input.pgid) && input.pgid > 1 ? input.pgid : probed ?? pid;
	const nowMs = Date.now();
	const rec = {
		pid,
		pgid,
		label: String(input.label || "omp-child").slice(0, 64),
		...(input.taskId ? { taskId: String(input.taskId).slice(0, 96) } : {}),
		...(input.command ? { command: String(input.command).slice(0, 200) } : {}),
		startedAt: new Date(nowMs).toISOString(),
		startedAtMs: nowMs,
		ownerPid: process.pid,
	};
	try {
		const prev = readTrackedProcessesDaemon(root).filter((r) => r?.pid !== pid);
		prev.push(rec);
		atomicWriteJsonDaemon(processTrackerPathDaemon(root), {
			schema: 1,
			updatedAt: new Date().toISOString(),
			records: prev,
		});
	} catch {
		/* 登记失败不阻断守护启动 */
	}
	return rec;
}

function unregisterTrackedProcessDaemon(root, pid) {
	const p = processTrackerPathDaemon(root);
	if (!existsSync(p)) return;
	try {
		const prev = readTrackedProcessesDaemon(root);
		const next = prev.filter((r) => r?.pid !== pid);
		if (next.length !== prev.length) {
			atomicWriteJsonDaemon(p, { schema: 1, updatedAt: new Date().toISOString(), records: next });
		}
	} catch {
		/* ignore */
	}
}

/** 守护器侧进程组级联回收（SIGTERM -> graceMs -> SIGKILL），与 omp/storage.ts 的 ProcessGroupTracker 协议一致。 */
function cleanupTrackedProcessesDaemon(root, opts = {}) {
	const p = processTrackerPathDaemon(root);
	if (!existsSync(p)) return { cleanedCount: 0, sigkillCount: 0 };
	const graceMs =
		typeof opts.graceMs === "number" && Number.isFinite(opts.graceMs) && opts.graceMs >= 0
			? Math.floor(opts.graceMs)
			: 500;
	const records = readTrackedProcessesDaemon(root);
	const targets = records.filter((r) => !opts.taskId || r?.taskId === opts.taskId);
	if (targets.length === 0) return { cleanedCount: 0, sigkillCount: 0 };

	const pending = [];
	let cleanedCount = 0;
	for (const rec of targets) {
		if (!isSafeDaemonTargetPid(rec?.pid)) continue;
		const pgid = Number(rec.pgid ?? rec.pid);
		const alive = isSafeDaemonTargetPgid(pgid)
			? isGroupAliveNonZombieDaemon(pgid, rec.pid)
			: isProcessAliveNonZombieDaemon(rec.pid);
		if (!alive) {
			cleanedCount += 1;
			continue;
		}
		if (killPidOrGroupSafeDaemon(rec.pid, pgid, "SIGTERM")) {
			pending.push({ pid: rec.pid, pgid, useGroup: isSafeDaemonTargetPgid(pgid) });
		}
	}

	const deadline = Date.now() + graceMs;
	const aliveSet = new Set(pending);
	while (aliveSet.size > 0) {
		for (const item of [...aliveSet]) {
			const alive = item.useGroup
				? isGroupAliveNonZombieDaemon(item.pgid, item.pid)
				: isProcessAliveNonZombieDaemon(item.pid);
			if (!alive) {
				cleanedCount += 1;
				aliveSet.delete(item);
			}
		}
		if (aliveSet.size === 0 || Date.now() >= deadline) break;
		sleepSyncDaemon(Math.min(30, Math.max(1, deadline - Date.now())));
	}

	let sigkillCount = 0;
	for (const item of aliveSet) {
		if (killPidOrGroupSafeDaemon(item.pid, item.pgid, "SIGKILL")) {
			sigkillCount += 1;
			cleanedCount += 1;
		}
	}

	try {
		const handledPids = new Set(targets.map((r) => r?.pid));
		const next = readTrackedProcessesDaemon(root).filter((r) => !handledPids.has(r?.pid));
		atomicWriteJsonDaemon(p, { schema: 1, updatedAt: new Date().toISOString(), records: next });
		if (cleanedCount > 0) {
			appendJournalDaemon(root, {
				type: "process_group_cleanup",
				source: "nuwa-autonomous",
				reason: opts.reason ?? "daemon_cleanup",
				...(opts.taskId ? { taskId: opts.taskId } : {}),
				cleanedCount,
				sigkillCount,
			});
		}
	} catch {
		/* ignore */
	}
	return { cleanedCount, sigkillCount };
}

function readDaemonPausedState(root) {
	const p = join(root, ".nuwa", "paused.json");
	if (!existsSync(p)) return null;
	try {
		const parsed = JSON.parse(readFileSync(p, "utf8"));
		if (parsed && typeof parsed.paused === "boolean") return parsed;
	} catch {
		/* ignore */
	}
	return null;
}

function isDaemonPaused(root) {
	return readDaemonPausedState(root)?.paused === true;
}

/** 守护器侧子代理心跳看门狗巡检（与 omp/storage.ts 的 SubagentWatchdog 共用 .nuwa/subagent-watchdog.json）。 */
function sweepSubagentWatchdogDaemon(root) {
	const p = join(root, ".nuwa", "subagent-watchdog.json");
	if (!existsSync(p)) return [];
	let store;
	try {
		store = JSON.parse(readFileSync(p, "utf8"));
	} catch {
		return [];
	}
	if (!store?.tasks || typeof store.tasks !== "object") return [];
	const nowMs = Date.now();
	const timedOut = [];
	let mutated = false;

	for (const entry of Object.values(store.tasks)) {
		if (!entry || entry.status !== "running") continue;
		const idleLimit =
			Number.isFinite(entry.idleTimeoutMs) && entry.idleTimeoutMs > 0
				? entry.idleTimeoutMs
				: DEFAULT_SUBAGENT_IDLE_TIMEOUT_MS;
		const hardLimit =
			Number.isFinite(entry.hardTimeoutMs) && entry.hardTimeoutMs > 0
				? entry.hardTimeoutMs
				: DEFAULT_SUBAGENT_HARD_TIMEOUT_MS;
		const elapsedMs = Math.max(0, nowMs - Number(entry.startedAt ?? nowMs));
		const idleMs = Math.max(0, nowMs - Number(entry.lastOutputAt ?? entry.startedAt ?? nowMs));
		let timeoutKind = "";
		let reason = "";
		if (elapsedMs >= hardLimit) {
			timeoutKind = "hard_timeout";
			reason = `子代理任务 ${entry.taskId} 触发硬超时 (${Math.round(elapsedMs / 1000)}s >= ${Math.round(hardLimit / 1000)}s)`;
		} else if (idleMs >= idleLimit) {
			timeoutKind = "idle_no_output";
			reason = `子代理任务 ${entry.taskId} 触发无输出空闲超时 (${Math.round(idleMs / 1000)}s >= ${Math.round(idleLimit / 1000)}s)`;
		}
		if (!timeoutKind) continue;

		cleanupTrackedProcessesDaemon(root, {
			taskId: entry.taskId,
			graceMs: 300,
			reason: `watchdog:${timeoutKind}:${entry.taskId}`,
		});
		if (isSafeDaemonTargetPid(entry.pid)) {
			killPidOrGroupSafeDaemon(entry.pid, Number(entry.pgid ?? entry.pid), "SIGTERM");
		}
		entry.status = "timeout";
		entry.endedAt = nowMs;
		entry.timeoutKind = timeoutKind;
		entry.timeoutReason = reason;
		mutated = true;
		timedOut.push({ taskId: entry.taskId, timeoutKind, reason, idleMs, elapsedMs });
		logErr(`[SubagentWatchdog] ${reason}，已标记 timeout 并释放并发槽位。`);
		appendJournalDaemon(root, {
			type: "subagent_timeout",
			source: "nuwa-autonomous",
			taskId: entry.taskId,
			timeoutKind,
			idleMs,
			elapsedMs,
			reason,
		});
	}

	if (mutated) {
		try {
			store.updatedAt = new Date().toISOString();
			atomicWriteJsonDaemon(p, store);
		} catch {
			/* ignore */
		}
	}
	return timedOut;
}

function inspectGitMetadataDaemon(root) {
	const gitEntry = join(root, ".git");
	if (!existsSync(gitEntry)) return { gitPresent: false, gitHeadValid: false };
	try {
		const st = statSync(gitEntry);
		if (st.isDirectory()) return { gitPresent: true, gitHeadValid: existsSync(join(gitEntry, "HEAD")) };
		if (st.isFile()) {
			const m = /^gitdir:\s*(.+)$/im.exec(readFileSync(gitEntry, "utf8").trim());
			if (!m?.[1]) return { gitPresent: true, gitHeadValid: false };
			return { gitPresent: true, gitHeadValid: existsSync(join(resolve(root, m[1].trim()), "HEAD")) };
		}
	} catch {
		return { gitPresent: true, gitHeadValid: false };
	}
	return { gitPresent: false, gitHeadValid: false };
}

/** 守护器启动与每轮结算工作区完整性校验（与 omp/storage.ts 的 verifyWorkspaceIntegrity 协议一致）。 */
function verifyWorkspaceIntegrityDaemon(root, opts = {}) {
	const normRoot = resolve(root);
	const warnings = [];
	let exists = false;
	try {
		exists = existsSync(normRoot) && statSync(normRoot).isDirectory();
	} catch {
		exists = false;
	}
	const nuwaDir = join(normRoot, ".nuwa");
	const hasNuwaDir = exists && existsSync(nuwaDir);
	const metaPath = join(nuwaDir, "workspace-meta.json");
	let meta = null;
	if (hasNuwaDir && existsSync(metaPath)) {
		try {
			meta = JSON.parse(readFileSync(metaPath, "utf8"));
		} catch {
			meta = null;
		}
	}
	const { gitPresent, gitHeadValid } = exists ? inspectGitMetadataDaemon(normRoot) : { gitPresent: false, gitHeadValid: false };
	const expectGitEnv = (process.env.NUWA_EXPECT_GIT ?? "").trim() === "1";

	if (exists && opts.recordBaseline && hasNuwaDir) {
		try {
			atomicWriteJsonDaemon(metaPath, {
				schema: 1,
				root: normRoot,
				hadGit: Boolean(meta?.hadGit || gitPresent || expectGitEnv),
				firstSeenAt: meta?.firstSeenAt ?? new Date().toISOString(),
				updatedAt: new Date().toISOString(),
			});
		} catch {
			/* ignore */
		}
	}

	const gitExpected = Boolean(expectGitEnv || meta?.hadGit || gitPresent);
	if (!exists) {
		warnings.push({
			code: "NUWA_WORKSPACE_MISSING",
			severity: "error",
			message: `工作区目录已丢失: ${normRoot}`,
		});
	} else if (gitExpected && (!gitPresent || !gitHeadValid)) {
		warnings.push({
			code: "NUWA_GIT_METADATA_MISSING",
			severity: "error",
			message: !gitPresent ? `工作区 .git 元数据丢失: ${normRoot}` : `工作区 .git 损坏（缺少有效 HEAD）: ${normRoot}`,
		});
	}

	const isVolatileTmp = isVolatileTempPathDaemon(normRoot);
	if (isVolatileTmp && !isDaemonTmpWarningSuppressed()) {
		warnings.push({
			code: "NUWA_VOLATILE_TMP_WORKSPACE",
			severity: "warn",
			message: `工作区位于易失临时目录 (${normRoot})，建议迁移至持久化目录 ${resolveDefaultWorkspacesDirDaemon()} 或设置 NUWA_STATE_DIR`,
		});
	}

	const hasError = warnings.some((w) => w.severity === "error");
	const status = hasError ? "corrupted" : warnings.length > 0 ? "warn" : "ok";
	if (hasError && hasNuwaDir) {
		appendJournalDaemon(normRoot, {
			type: "workspace_integrity_alert",
			source: "nuwa-autonomous",
			status,
			root: normRoot,
			warnings,
		});
	}
	return { ok: !hasError, status, exists, isVolatileTmp, gitExpected, gitPresent, gitHeadValid, warnings };
}

function buildUnifiedNetworkEnvDaemon(egressUrl, allowedHosts = []) {
	const cleanProxy = String(egressUrl ?? "").trim();
	const ghSec = String(getGhHttpTimeoutSec());
	const noProxySet = new Set(["127.0.0.1", "localhost", "::1"]);
	if (cleanProxy) {
		try {
			const u = new URL(cleanProxy);
			const h = u.hostname.toLowerCase();
			if (h === "host.docker.internal" || h === "127.0.0.1" || h === "localhost" || h === "::1") {
				noProxySet.add(h);
			}
		} catch {
			/* ignore */
		}
	}
	const noProxy = [...noProxySet].join(",");
	const out = {
		GH_HTTP_TIMEOUT: ghSec,
		GIT_TERMINAL_PROMPT: "0",
		GIT_HTTP_LOW_SPEED_LIMIT: "1",
		GIT_HTTP_LOW_SPEED_TIME: ghSec,
		NO_PROXY: noProxy,
		no_proxy: noProxy,
	};
	if (cleanProxy) {
		out.HTTP_PROXY = cleanProxy;
		out.http_proxy = cleanProxy;
		out.HTTPS_PROXY = cleanProxy;
		out.https_proxy = cleanProxy;
		out.NUWA_EGRESS_PROXY = cleanProxy;
		if (/^socks/i.test(cleanProxy)) {
			out.ALL_PROXY = cleanProxy;
			out.all_proxy = cleanProxy;
		}
	}
	const cleanHosts = [...new Set(allowedHosts.map((h) => String(h ?? "").trim().toLowerCase()).filter(Boolean))];
	if (cleanHosts.length > 0) {
		out.NUWA_SCOPE_ALLOW_HOSTS = cleanHosts.join(",");
	}
	return out;
}

function sqliteDbPathDaemon(root) {
	return join(root, ".nuwa", "nuwa.db");
}

function resolveStorageBackendDaemon(root) {
	const raw = String(process.env.NUWA_STORAGE_BACKEND ?? "").trim().toLowerCase();
	if (raw === "json" || raw === "sqlite" || raw === "dual") return raw;
	const dbFile = sqliteDbPathDaemon(root);
	if (existsSync(dbFile)) {
		try {
			if (statSync(dbFile).size > 0) return "sqlite";
		} catch {
			/* ignore */
		}
	}
	return "json";
}

function readSqliteStateDaemon(root) {
	const dbFile = sqliteDbPathDaemon(root);
	if (!existsSync(dbFile)) return null;
	let db = null;
	try {
		db = openReadonlyKbDb(dbFile);

		const metaRows = db
			.query("SELECT key, value FROM meta WHERE key IN ('project_json', 'runtime_json')")
			.all();
		let project = null;
		let runtime = {};
		for (const row of metaRows) {
			if (row?.key === "project_json" && typeof row.value === "string") {
				project = JSON.parse(row.value);
			} else if (row?.key === "runtime_json" && typeof row.value === "string") {
				runtime = JSON.parse(row.value);
			}
		}
		if (!project || typeof project !== "object") return null;

		const facts = {};
		for (const row of db.query("SELECT id, kind, verify_stage FROM facts").all()) {
			if (!row?.id) continue;
			facts[row.id] = {
				id: String(row.id),
				kind: String(row.kind ?? "note"),
				...(row.verify_stage ? { verifyStage: String(row.verify_stage) } : {}),
			};
		}

		const intents = {};
		for (const row of db.query("SELECT id, status FROM intents").all()) {
			if (!row?.id) continue;
			intents[row.id] = {
				id: String(row.id),
				status: String(row.status ?? "open"),
			};
		}

		return { project, runtime, facts, intents };
	} catch {
		return null;
	} finally {
		try {
			db?.close();
		} catch {
			/* ignore */
		}
	}
}

function readDiskState(root) {
	const backend = resolveStorageBackendDaemon(root);
	if (backend === "sqlite" || backend === "dual") {
		const sqliteState = readSqliteStateDaemon(root);
		if (sqliteState) return sqliteState;
	}
	const p = stateFilePath(root);
	if (existsSync(p)) {
		try {
			const parsed = JSON.parse(readFileSync(p, "utf8"));
			if (parsed && typeof parsed === "object" && parsed.project) return parsed;
		} catch {
			/* ignore */
		}
	}
	return readSqliteStateDaemon(root);
}

function isReincarnateStop(state) {
	if (!state || state.project?.status !== "stopped") return false;
	const stopReason = String(state.project?.stopReason ?? "");
	if (REINCARNATE_STOP_RE.test(stopReason)) return true;
	if (state.runtime?.reincarnatePending === true) return true;
	return false;
}

function defaultGoalFor(mode, target) {
	switch (mode) {
		case "coding":
			return `对 ${target} 完成自主代码分析、实现与全量测试验证`;
		case "ops":
			return `对 ${target} 完成服务巡检、故障定位与恢复验收`;
		case "audit":
			return `对 ${target} 完成安全审计并输出可复验风险证据`;
		case "pentest":
			return `对 ${target} 完成授权渗透评估并留存完整证据链`;
		case "ctf":
		default:
			return `对 ${target} 完成完整评估并取得验证 flag`;
	}
}

function buildChildEnv(opts, gen) {
	const allowedHosts = [];
	if (opts.target) {
		try {
			const parsed = new URL(/^https?:\/\//i.test(opts.target) ? opts.target : `http://${opts.target}`);
			if (parsed.hostname) allowedHosts.push(parsed.hostname);
		} catch {
			/* ignore */
		}
	}
	const effectiveProxy = (opts.egressProxy || process.env.NUWA_EGRESS_PROXY || "").trim();
	const unifiedNetEnv = buildUnifiedNetworkEnvDaemon(effectiveProxy, allowedHosts);
	const env = {
		...process.env,
		...unifiedNetEnv,
		NUWA_LOOP: "1",
		NUWA_INFINITE: "1",
		NUWA_HEADLESS_DAEMON: "1",
		NUWA_STRICT_EVIDENCE: "1",
		NUWA_REINCARNATE_TOKENS: String(opts.reincarnateTokens),
		NUWA_REINCARNATE_TURNS: String(opts.reincarnateTurns),
		NUWA_PROJECT: opts.root,
		NUWA_GENERATION: String(gen),
	};
	delete env.NUWA_WEBHOOK_URL;
	if (opts.target) {
		env.NUWA_TARGET = opts.target;
	}
	if (opts.allowSubdomains) {
		env.NUWA_SCOPE_ALLOW_SUBDOMAINS = "1";
	}
	if (opts.allowCidrs.length > 0) {
		env.NUWA_SCOPE_ALLOW_CIDRS = opts.allowCidrs.join(",");
	}
	if (opts.sandboxExplicit || opts.sandbox !== "none") {
		env.NUWA_SANDBOX = opts.sandbox;
	}
	if (opts.sandboxImage) {
		env.NUWA_SANDBOX_IMAGE = opts.sandboxImage;
	}
	if (opts.fastModel) {
		env.NUWA_MODEL_FAST = opts.fastModel;
	}
	if (opts.deepModel) {
		env.NUWA_MODEL_DEEP = opts.deepModel;
	}
	if (opts.verifyModel) {
		env.NUWA_MODEL_VERIFY = opts.verifyModel;
	}
	return env;
}

function buildPrompt(opts, state, gen) {
	const target = state?.project?.url || state?.project?.target || opts.target;
	const mode = state?.project?.mode || opts.mode;
	const goal = state?.project?.goal || opts.goal || defaultGoalFor(mode, target);
	const phase = state?.project?.phase || "recon";
	const stateGen = Number(state?.runtime?.generation ?? 0);
	const displayGen = Math.max(gen, stateGen || 1);
	const handoff = typeof state?.runtime?.handoffSummary === "string" ? state.runtime.handoffSummary.trim() : "";

	if (handoff) {
		return [
			`[女娲无头守护 · 第 ${displayGen} 代交接接力]`,
			`目标: ${target} (mode=${mode})`,
			`项目根目录: ${opts.root}`,
			`当前阶段: ${phase} · 世代: G${displayGen}`,
			``,
			`上一代交接摘要:`,
			handoff,
			``,
			`接力指令:`,
			`1. 先调用 nuwa_init(root=${JSON.stringify(opts.root)}, resume=true, force=true) 接管当前无头会话所有权，再调 nuwa_status 确认最新盘面。`,
			`2. 严格沿用交接摘要中的关键事实与避坑经验，继续通过 nuwa_frontier → nuwa_claim → task(agent="fujiang") → nuwa_commit 推进，避免重复已证伪路径。`,
			`3. 目标达成后调用 nuwa_complete 验收并执行 nuwa_report(write=true) 生成最终报告；未验收前不得自行停机。`,
		].join("\n");
	}

	if (state) {
		const factCount = Object.keys(state.facts ?? {}).length;
		const openCount = Object.values(state.intents ?? {}).filter((i) => i.status === "open" || i.status === "claimed").length;
		return [
			`[女娲无头守护 · 第 ${displayGen} 代恢复起跑]`,
			`目标: ${target} (mode=${mode}) — ${goal}`,
			`项目根目录: ${opts.root}`,
			`当前磁盘状态: phase=${phase} facts=${factCount} open/claimed=${openCount}`,
			``,
			`恢复指令:`,
			`1. 立即调用 nuwa_init(root=${JSON.stringify(opts.root)}, resume=true, force=true) 接管会话所有权并确认 nuwa_status。`,
			`2. 继续推进未完成 frontier 意图，证据全部经真实命令回显入账。`,
			`3. 达成验收条件后调用 nuwa_complete 与 nuwa_report(write=true) 收尾。`,
		].join("\n");
	}

	return [
		`[女娲无头守护 · 第 ${displayGen} 代首次起跑]`,
		`目标: ${target} (mode=${mode}) — ${goal}`,
		`项目根目录: ${opts.root}`,
		``,
		`起跑指令:`,
		`1. 立即调用 nuwa_init(target=${JSON.stringify(target)}, mode=${JSON.stringify(mode)}, goal=${JSON.stringify(goal)}, root=${JSON.stringify(opts.root)}, autoStart=true) 初始化女娲项目（若目录已有同目标项目则使用 resume=true, force=true 接管）。`,
		`2. 按女娲纪律持续推进（nuwa_frontier → nuwa_claim → task(agent="fujiang") → nuwa_commit / nuwa_flag），所有结论必须附带真实执行命令与关键回显。`,
		`3. 目标完成后调用 nuwa_complete 验收并执行 nuwa_report(write=true) 输出报告；未完成前不得输出收工结论。`,
	].join("\n");
}

function buildOmpArgs(opts, prompt) {
	const args = ["-p", "--cwd", opts.root];
	if (opts.model) {
		args.push("--model", opts.model);
	}
	args.push("--", prompt);
	return args;
}

function formatCompletionSummary(root, state, gen, startedAt) {
	const facts = Object.values(state.facts ?? {});
	const flags = facts.filter((f) => f.kind === "flag").length;
	const vulns = facts.filter((f) => f.kind === "vuln").length;
	const loots = facts.filter((f) => f.kind === "loot").length;
	const elapsedSec = Math.max(0, Math.round((Date.now() - startedAt) / 1000));
	const reportPath = reportFilePath(root);
	const reportHint = existsSync(reportPath) ? `${reportPath}（已生成）` : `${reportPath}（未写入，可运行 nuwa_report 生成）`;
	return [
		`任务已完成 (status=completed)`,
		`  项目: ${state.project?.id ?? "-"} (${state.project?.url ?? state.project?.target ?? "-"})`,
		`  模式: ${state.project?.mode ?? "-"} · 阶段: ${state.project?.phase ?? "-"} · 守护世代: ${gen} (state.gen=${state.runtime?.generation ?? 1})`,
		`  耗时: ${elapsedSec}s · 事实: ${facts.length} (flag=${flags}, vuln=${vulns}, loot=${loots})`,
		`  报告: ${reportHint}`,
	].join("\n");
}

function maskWebhookUrl(rawUrl) {
	const text = String(rawUrl ?? "").trim();
	if (!text) return "";
	try {
		const u = new URL(text);
		const origin = `${u.protocol}//${u.host}`;
		const segs = u.pathname.split("/").filter(Boolean);
		if (segs.length >= 2) {
			return `${origin}/${segs[0]}/***`;
		}
		if (segs.length === 1) {
			const seg = segs[0];
			const looksSecret = seg.length >= 16 || /[0-9a-f]{10,}|[A-Za-z0-9_-]{20,}/i.test(seg);
			const pathPart = looksSecret ? "/***" : `/${seg}`;
			return u.search ? `${origin}${pathPart}?***` : `${origin}${pathPart}`;
		}
		return u.search ? `${origin}/?***` : origin;
	} catch {
		return "***";
	}
}

function collectVaultSecretStrings(root) {
	if (!root) return [];
	const vaultPath = join(root, ".nuwa", "sessions", "vault.json");
	if (!existsSync(vaultPath)) return [];
	try {
		const parsed = JSON.parse(readFileSync(vaultPath, "utf8"));
		const roles = parsed?.roles;
		if (!roles || typeof roles !== "object") return [];
		const secrets = new Set();
		const pushVal = (v, minLen = 4) => {
			const s = String(v ?? "").trim();
			if (s.length >= minLen) secrets.add(s);
		};
		for (const entry of Object.values(roles)) {
			if (!entry || typeof entry !== "object") continue;
			if (typeof entry.bearer === "string") {
				pushVal(entry.bearer, 4);
				const bare = entry.bearer.replace(/^(?:Bearer|Token|Basic|JWT)\s+/i, "").trim();
				if (bare) pushVal(bare, 4);
			}
			if (typeof entry.cookie === "string") {
				pushVal(entry.cookie, 4);
				for (const part of entry.cookie.split(";")) {
					const eq = part.indexOf("=");
					if (eq > 0) pushVal(part.slice(eq + 1), 4);
				}
			}
			if (typeof entry.password === "string") {
				pushVal(entry.password, 3);
				if (typeof entry.username === "string" && entry.username.trim()) {
					pushVal(Buffer.from(`${entry.username}:${entry.password}`, "utf8").toString("base64"), 4);
				}
			}
			if (entry.headers && typeof entry.headers === "object") {
				for (const [hk, hv] of Object.entries(entry.headers)) {
					if (/(?:auth|token|key|secret|cookie|session|jwt|csrf|pass|cred|bearer)/i.test(hk)) {
						pushVal(hv, 4);
						const bare = String(hv ?? "").replace(/^(?:Bearer|Token|Basic|JWT)\s+/i, "").trim();
						if (bare) pushVal(bare, 4);
					}
				}
			}
		}
		return [...secrets].sort((a, b) => b.length - a.length);
	} catch {
		return [];
	}
}

function redactSecretPatterns(text, vaultSecrets = []) {
	let out = String(text ?? "");
	if (!out) return out;
	for (const secret of vaultSecrets) {
		if (secret && out.includes(secret)) {
			out = out.split(secret).join("***");
		}
	}
	out = out
		.replace(/(Authorization\s*:\s*(?:Bearer|Token|Basic|JWT)\s+)[^\s'",;\r\n]+/gi, "$1***")
		.replace(/\b(Bearer|Token|Basic|JWT)\s+[A-Za-z0-9._~+/=-]{6,}/gi, "$1 ***")
		.replace(/\beyJ[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{4,}\b/g, "eyJ***")
		.replace(/\b(?:sk-[A-Za-z0-9_-]{8,}|ak_[A-Za-z0-9_-]{8,}|ghp_[A-Za-z0-9]{10,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{16,})\b/g, "***")
		.replace(
			/\b((?:password|passwd|pass|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|token|cookie)\s*[:=]\s*)(?:"[^"\r\n]*"|'[^'\r\n]*'|[^\s,;'"\r\n]+)/gi,
			"$1***",
		)
		.replace(/(https?:\/\/)[^/\s@]+:[^/\s@]+@/gi, "$1***@")
		.replace(/([?&](?:token|key|secret|auth|sig|password|pass|api_key)=)[^&\s]+/gi, "$1***");
	return out;
}

function redactWebhookPayload(value, root, vaultSecrets = collectVaultSecretStrings(root)) {
	if (typeof value === "string") {
		return redactSecretPatterns(value, vaultSecrets);
	}
	if (Array.isArray(value)) {
		return value.map((item) => redactWebhookPayload(item, root, vaultSecrets));
	}
	if (value && typeof value === "object") {
		const out = {};
		for (const [k, v] of Object.entries(value)) {
			if (v === undefined) continue;
			out[k] = redactWebhookPayload(v, root, vaultSecrets);
		}
		return out;
	}
	return value;
}

function appendWebhookDeadletter(root, entry) {
	try {
		const dir = join(root, ".nuwa");
		mkdirSync(dir, { recursive: true });
		const dlPath = join(dir, "webhook-deadletter.jsonl");
		appendFileSync(dlPath, `${JSON.stringify(entry)}\n`, { encoding: "utf8", mode: 0o600 });
		try {
			chmodSync(dlPath, 0o600);
		} catch {
			/* 非 POSIX 文件系统忽略 */
		}
	} catch {
		/* 写死信队列失败不崩溃守护进程 */
	}
}

async function sendDaemonWebhook(webhookUrl, root, payload, opts = {}) {
	const targetUrl = String(webhookUrl ?? "").trim();
	if (!targetUrl) return { ok: false, skipped: true };

	const redactedPayload = redactWebhookPayload(payload, root);
	const body = JSON.stringify(redactedPayload);
	const maskedUrl = maskWebhookUrl(targetUrl);
	const timeoutMs = Number.isFinite(opts.timeoutMs) && opts.timeoutMs > 0 ? opts.timeoutMs : WEBHOOK_TIMEOUT_MS;

	let retryDelays = [100, 250];
	if (Array.isArray(opts.retryDelaysMs)) {
		retryDelays = opts.retryDelaysMs;
	} else {
		const envRetry = (process.env.NUWA_WEBHOOK_RETRY_MS ?? "").trim();
		if (envRetry) {
			const parsed = Number(envRetry);
			if (Number.isFinite(parsed) && parsed >= 0) {
				retryDelays = [parsed, parsed * 2];
			}
		}
	}

	let lastError = "unknown webhook error";
	for (let attempt = 1; attempt <= WEBHOOK_MAX_ATTEMPTS; attempt += 1) {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), timeoutMs);
		try {
			const res = await fetch(targetUrl, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					"User-Agent": "pi-nuwa-autonomous/5.0",
				},
				body,
				signal: controller.signal,
			});
			if (res.ok) {
				return { ok: true, status: res.status, attempts: attempt };
			}
			lastError = `HTTP ${res.status}${res.statusText ? ` ${res.statusText}` : ""}`;
		} catch (err) {
			const rawMsg = err instanceof Error ? err.message : String(err);
			lastError = rawMsg.includes(targetUrl) ? rawMsg.split(targetUrl).join(maskedUrl) : rawMsg;
		} finally {
			clearTimeout(timer);
		}

		if (attempt < WEBHOOK_MAX_ATTEMPTS) {
			const delayMs = retryDelays[attempt - 1] ?? retryDelays[retryDelays.length - 1] ?? 100;
			if (delayMs > 0) {
				await Bun.sleep(delayMs);
			}
		}
	}

	appendWebhookDeadletter(root, {
		ts: new Date().toISOString(),
		url: maskedUrl,
		attempts: WEBHOOK_MAX_ATTEMPTS,
		error: redactSecretPatterns(lastError),
		payload: redactedPayload,
	});
	logErr(`Webhook 推送失败 (${maskedUrl}，已重试 ${WEBHOOK_MAX_ATTEMPTS} 次，已写入 .nuwa/webhook-deadletter.jsonl): ${redactSecretPatterns(lastError)}`);
	return { ok: false, attempts: WEBHOOK_MAX_ATTEMPTS, error: lastError, deadlettered: true };
}

function computeCumulativeBudget(state, opts) {
	const rt = state?.runtime ?? {};
	const baseTokens = Number(rt.totalTokens ?? 0);
	const curTokens = Number(rt.tokens ?? 0);
	const cumulativeTokens =
		(Number.isFinite(baseTokens) && baseTokens > 0 ? baseTokens : 0) +
		(Number.isFinite(curTokens) && curTokens > 0 ? curTokens : 0);
	const recordedUsd = Number(rt.totalCostUsd ?? 0);
	const cumulativeUsd =
		Number.isFinite(recordedUsd) && recordedUsd > 0
			? recordedUsd
			: (cumulativeTokens / 1_000_000) * opts.usdPer1mTokens;
	return { cumulativeTokens, cumulativeUsd };
}

function checkBudgetCap(state, opts) {
	if (!state) return { exceeded: false, cumulativeTokens: 0, cumulativeUsd: 0 };
	const { cumulativeTokens, cumulativeUsd } = computeCumulativeBudget(state, opts);
	if (opts.maxTotalTokens > 0 && cumulativeTokens >= opts.maxTotalTokens) {
		return {
			exceeded: true,
			kind: "tokens",
			limit: opts.maxTotalTokens,
			cumulativeTokens,
			cumulativeUsd,
			reason: `跨世代累计 Token 已达上限 (${cumulativeTokens} >= ${opts.maxTotalTokens})`,
		};
	}
	if (opts.maxUsd > 0 && cumulativeUsd >= opts.maxUsd) {
		return {
			exceeded: true,
			kind: "usd",
			limit: opts.maxUsd,
			cumulativeTokens,
			cumulativeUsd,
			reason: `跨世代累计费用已达上限 ($${cumulativeUsd.toFixed(4)} >= $${opts.maxUsd.toFixed(4)})`,
		};
	}
	return { exceeded: false, cumulativeTokens, cumulativeUsd };
}

function buildWebhookEventPayload(event, opts, state, gen, extra = {}) {
	const { cumulativeTokens, cumulativeUsd } = computeCumulativeBudget(state, opts);
	const facts = Object.values(state?.facts ?? {});
	const flags = facts.filter((f) => f?.kind === "flag").length;
	const confirmedVulns = facts.filter(
		(f) => f?.kind === "vuln" && f?.verifyStage !== "candidate" && f?.verifyStage !== "rejected",
	).length;
	return {
		event,
		ts: new Date().toISOString(),
		projectId: state?.project?.id ?? "",
		target: state?.project?.url || state?.project?.target || opts.target,
		mode: state?.project?.mode || opts.mode,
		phase: state?.project?.phase || "recon",
		status: state?.project?.status || "active",
		generation: gen,
		stateGeneration: Number(state?.runtime?.generation ?? gen),
		cumulativeTokens,
		cumulativeUsd: Number(cumulativeUsd.toFixed(6)),
		factsCount: facts.length,
		flags,
		confirmedVulns,
		...extra,
	};
}

function persistDaemonConfig(opts, effectiveTarget, effectiveMode, effectiveGoal) {
	try {
		const dir = join(opts.root, ".nuwa");
		mkdirSync(dir, { recursive: true });
		const cfgPath = join(dir, "daemon-config.json");
		const payload = {
			target: effectiveTarget,
			mode: effectiveMode,
			goal: effectiveGoal,
			root: opts.root,
			maxGenerations: opts.maxGenerations,
			maxHours: opts.maxHours,
			genTimeoutMinutes: opts.genTimeoutMinutes,
			idleTimeoutMinutes: opts.idleTimeoutMinutes,
			reincarnateTokens: opts.reincarnateTokens,
			reincarnateTurns: opts.reincarnateTurns,
			maxTotalTokens: opts.maxTotalTokens,
			maxUsd: opts.maxUsd,
			usdPer1mTokens: opts.usdPer1mTokens,
			webhook: opts.webhook ? maskWebhookUrl(opts.webhook) : undefined,
			allowSubdomains: opts.allowSubdomains,
			allowCidrs: opts.allowCidrs,
			model: opts.model || undefined,
			fastModel: opts.fastModel || undefined,
			deepModel: opts.deepModel || undefined,
			verifyModel: opts.verifyModel || undefined,
			sandbox: opts.sandbox,
			sandboxImage: opts.sandboxImage || undefined,
			updatedAt: new Date().toISOString(),
		};
		writeFileSync(cfgPath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
	} catch {
		/* 记录辅助配置失败不阻断守护启动 */
	}
}

function shellQuotePreview(arg) {
	return `'${String(arg).replace(/'/g, `'\\''`)}'`;
}

function formatDurationMs(ms) {
	if (ms < 1000) return `${Math.round(ms)}ms`;
	if (ms < 60_000) return `${Number((ms / 1000).toFixed(2))}s`;
	return `${Number((ms / 60_000).toFixed(2))}min`;
}

function fileActivityPart(filePath) {
	try {
		const st = statSync(filePath);
		return `${st.mtimeMs}:${st.size}:${st.ino}`;
	} catch {
		return "missing";
	}
}

function readActivitySignature(root) {
	const nuwaDir = join(root, ".nuwa");
	return [
		fileActivityPart(join(nuwaDir, "journal.jsonl")),
		fileActivityPart(join(nuwaDir, "state.json")),
		fileActivityPart(join(nuwaDir, "nuwa.db")),
		fileActivityPart(join(nuwaDir, "nuwa.db-wal")),
	].join("|");
}

async function awaitChildWithWatchdog(child, params) {
	const {
		root,
		gen,
		hardDeadlineMs,
		deadlineIsMaxHours,
		genTimeoutMs,
		idleTimeoutMs,
		maxHours,
		startedAt,
		maxDurationMs,
		isShuttingDown,
	} = params;

	let settled = false;
	let killing = false;
	let timedOut = false;
	let timeoutKind = "";
	let timeoutReason = "";
	let hardTimer = null;
	let idleTimer = null;
	let subagentSweepTimer = null;
	let sigkillTimer = null;

	const clearAllTimers = () => {
		if (hardTimer !== null) {
			clearTimeout(hardTimer);
			hardTimer = null;
		}
		if (idleTimer !== null) {
			clearInterval(idleTimer);
			idleTimer = null;
		}
		if (subagentSweepTimer !== null) {
			clearInterval(subagentSweepTimer);
			subagentSweepTimer = null;
		}
		if (sigkillTimer !== null) {
			clearTimeout(sigkillTimer);
			sigkillTimer = null;
		}
	};

	const childPid = Number(child?.pid ?? 0);
	const probedChildPgid = childPid > 1 ? probePgidDaemon(childPid) : null;
	const childPgid = probedChildPgid && isSafeDaemonTargetPgid(probedChildPgid) ? probedChildPgid : childPid;

	const triggerWatchdog = (kind, reason) => {
		if (settled || killing || isShuttingDown()) return;
		killing = true;
		timedOut = true;
		timeoutKind = kind;
		timeoutReason = reason;
		if (hardTimer !== null) {
			clearTimeout(hardTimer);
			hardTimer = null;
		}
		if (idleTimer !== null) {
			clearInterval(idleTimer);
			idleTimer = null;
		}
		if (subagentSweepTimer !== null) {
			clearInterval(subagentSweepTimer);
			subagentSweepTimer = null;
		}
		logErr(reason);
		if (!killPidOrGroupSafeDaemon(childPid, childPgid, "SIGTERM")) {
			try {
				child.kill("SIGTERM");
			} catch {
				/* 子进程可能已退出 */
			}
		}
		sigkillTimer = setTimeout(() => {
			if (settled) return;
			logErr(`第 ${gen} 代子进程在 SIGTERM 后 ${WATCHDOG_SIGKILL_GRACE_MS}ms 仍未退出，按进程组发送 SIGKILL 强制终止。`);
			if (!killPidOrGroupSafeDaemon(childPid, childPgid, "SIGKILL")) {
				try {
					child.kill("SIGKILL");
				} catch {
					/* ignore */
				}
			}
			cleanupTrackedProcessesDaemon(root, { graceMs: 200, reason: `watchdog_sigkill:${kind}` });
		}, WATCHDOG_SIGKILL_GRACE_MS);
	};

	// 周期巡检子代理心跳看门狗（Issue #46 / NW-26）
	const subagentPollMs = Math.max(50, Math.min(5000, Number(process.env.NUWA_WATCHDOG_POLL_MS ?? 2000) || 2000));
	subagentSweepTimer = setInterval(() => {
		if (settled || killing || isShuttingDown()) return;
		try {
			sweepSubagentWatchdogDaemon(root);
		} catch {
			/* ignore */
		}
	}, subagentPollMs);
	subagentSweepTimer.unref?.();

	// 分片调度硬截止定时器，避免超大毫秒数触发 32-bit setTimeout 溢出
	const deadlineAt = Date.now() + Math.max(1, hardDeadlineMs);
	const armHardTimer = () => {
		if (settled || killing || isShuttingDown()) return;
		const remain = deadlineAt - Date.now();
		if (remain <= 0) {
			const hitMaxHours = deadlineIsMaxHours || Date.now() - startedAt >= maxDurationMs;
			if (hitMaxHours) {
				triggerWatchdog(
					"hard_max_hours",
					`第 ${gen} 代触发总时长硬上限 (maxHours=${maxHours}h)，发送 SIGTERM 终止子进程...`,
				);
			} else {
				triggerWatchdog(
					"hard_gen",
					`第 ${gen} 代触发单代超时看门狗 (genTimeout=${formatDurationMs(genTimeoutMs)})，发送 SIGTERM 终止子进程...`,
				);
			}
			return;
		}
		hardTimer = setTimeout(armHardTimer, Math.min(remain, MAX_SET_TIMEOUT_MS));
	};
	armHardTimer();

	if (idleTimeoutMs > 0) {
		let lastSig = readActivitySignature(root);
		let lastActivityAt = Date.now();
		const pollMs = Math.max(25, Math.min(5000, Math.floor(idleTimeoutMs / 4)));
		idleTimer = setInterval(() => {
			if (settled || killing || isShuttingDown()) return;
			const curSig = readActivitySignature(root);
			if (curSig !== lastSig) {
				lastSig = curSig;
				lastActivityAt = Date.now();
				return;
			}
			if (Date.now() - lastActivityAt >= idleTimeoutMs) {
				triggerWatchdog(
					"idle",
					`第 ${gen} 代触发空闲看门狗：.nuwa/journal.jsonl、.nuwa/state.json 与 .nuwa/nuwa.db(-wal) 连续 ${formatDurationMs(idleTimeoutMs)} 未更新，判定挂起并发送 SIGTERM...`,
				);
			}
		}, pollMs);
	}

	try {
		const rawExitCode = await child.exited;
		settled = true;
		clearAllTimers();
		return {
			exitCode: timedOut ? 124 : rawExitCode,
			timedOut,
			timeoutKind,
			timeoutReason,
		};
	} catch (err) {
		settled = true;
		clearAllTimers();
		throw err;
	}
}

async function main() {
	const rawArgv = process.argv.slice(2);
	if (rawArgv[0] === "doctor") {
		runDoctor(rawArgv.slice(1));
		return;
	}

	let opts;
	try {
		opts = parseArgs(rawArgv);
	} catch (err) {
		logErr(err instanceof Error ? err.message : String(err));
		process.exit(2);
	}

	if (opts.help) {
		console.log(HELP_TEXT.trimEnd());
		process.exit(0);
	}

	const initialState = readDiskState(opts.root);
	if (!opts.target && !initialState) {
		logErr(`未指定 --target 且 ${stateFilePath(opts.root)} 不存在（使用 --help 查看用法）`);
		process.exit(2);
	}

	const effectiveTarget = opts.target || initialState?.project?.target || initialState?.project?.url || "";
	const effectiveMode = opts.modeExplicit ? opts.mode : initialState?.project?.mode || opts.mode;
	const effectiveGoal = opts.goal || initialState?.project?.goal || defaultGoalFor(effectiveMode, effectiveTarget);
	opts.target = effectiveTarget;
	opts.mode = effectiveMode;
	opts.goal = effectiveGoal;

	if (opts.dryRun) {
		const envPreview = buildChildEnv(opts, 1);
		const prompt = buildPrompt(opts, initialState, 1);
		const ompArgs = buildOmpArgs(opts, prompt);
		const plan = {
			dryRun: true,
			root: opts.root,
			target: effectiveTarget,
			mode: effectiveMode,
			goal: effectiveGoal,
			maxGenerations: opts.maxGenerations,
			maxHours: opts.maxHours,
			genTimeoutMinutes: opts.genTimeoutMinutes,
			idleTimeoutMinutes: opts.idleTimeoutMinutes,
			reincarnateTokens: opts.reincarnateTokens,
			reincarnateTurns: opts.reincarnateTurns,
			maxTotalTokens: opts.maxTotalTokens,
			maxUsd: opts.maxUsd,
			usdPer1mTokens: opts.usdPer1mTokens,
			webhook: opts.webhook ? maskWebhookUrl(opts.webhook) : null,
			allowSubdomains: opts.allowSubdomains,
			allowCidrs: opts.allowCidrs,
			model: opts.model || null,
			fastModel: opts.fastModel || null,
			deepModel: opts.deepModel || null,
			verifyModel: opts.verifyModel || null,
			sandbox: opts.sandbox,
			sandboxImage: opts.sandboxImage || null,
			ompBin: opts.ompBin,
			existingState: Boolean(initialState),
			env: {
				NUWA_LOOP: envPreview.NUWA_LOOP,
				NUWA_INFINITE: envPreview.NUWA_INFINITE,
				NUWA_HEADLESS_DAEMON: envPreview.NUWA_HEADLESS_DAEMON,
				NUWA_STRICT_EVIDENCE: envPreview.NUWA_STRICT_EVIDENCE,
				NUWA_REINCARNATE_TOKENS: envPreview.NUWA_REINCARNATE_TOKENS,
				NUWA_REINCARNATE_TURNS: envPreview.NUWA_REINCARNATE_TURNS,
				NUWA_PROJECT: envPreview.NUWA_PROJECT,
				...(envPreview.NUWA_SCOPE_ALLOW_SUBDOMAINS
					? { NUWA_SCOPE_ALLOW_SUBDOMAINS: envPreview.NUWA_SCOPE_ALLOW_SUBDOMAINS }
					: {}),
				...(envPreview.NUWA_SCOPE_ALLOW_CIDRS
					? { NUWA_SCOPE_ALLOW_CIDRS: envPreview.NUWA_SCOPE_ALLOW_CIDRS }
					: {}),
				...(envPreview.NUWA_SANDBOX ? { NUWA_SANDBOX: envPreview.NUWA_SANDBOX } : {}),
				...(envPreview.NUWA_SANDBOX_IMAGE ? { NUWA_SANDBOX_IMAGE: envPreview.NUWA_SANDBOX_IMAGE } : {}),
				...(envPreview.NUWA_MODEL_FAST ? { NUWA_MODEL_FAST: envPreview.NUWA_MODEL_FAST } : {}),
				...(envPreview.NUWA_MODEL_DEEP ? { NUWA_MODEL_DEEP: envPreview.NUWA_MODEL_DEEP } : {}),
				...(envPreview.NUWA_MODEL_VERIFY ? { NUWA_MODEL_VERIFY: envPreview.NUWA_MODEL_VERIFY } : {}),
				...(envPreview.NUWA_EGRESS_PROXY ? { NUWA_EGRESS_PROXY: envPreview.NUWA_EGRESS_PROXY } : {}),
				...(envPreview.HTTP_PROXY ? { HTTP_PROXY: envPreview.HTTP_PROXY, HTTPS_PROXY: envPreview.HTTPS_PROXY } : {}),
				...(envPreview.NO_PROXY ? { NO_PROXY: envPreview.NO_PROXY } : {}),
				GH_HTTP_TIMEOUT: envPreview.GH_HTTP_TIMEOUT,
			},
			command: [opts.ompBin, ...ompArgs],
		};
		log("Dry-run 规划配置:");
		console.log(JSON.stringify(plan, null, 2));
		log(`首轮命令预览: ${[opts.ompBin, ...ompArgs.slice(0, -1), "<prompt>"].map(shellQuotePreview).join(" ")}`);
		process.exit(0);
	}

	if (opts.migratedFromTmp) {
		log(`[WorkspaceGuard] 默认工作目录位于易失临时路径，已自动迁出至持久化工作区: ${opts.root}`);
	}
	mkdirSync(opts.root, { recursive: true });
	persistDaemonConfig(opts, effectiveTarget, effectiveMode, effectiveGoal);

	// 启动期工作区完整性与易失 /tmp 校验（Issue #47 / NW-27）
	const reportIntegrityAlerts = async (phaseLabel, genNum, stateObj) => {
		const check = verifyWorkspaceIntegrityDaemon(opts.root, { recordBaseline: phaseLabel === "startup" });
		for (const w of check.warnings) {
			if (w.severity === "error") {
				logErr(`[WorkspaceGuard][${phaseLabel}] ${w.code}: ${w.message}`);
			} else {
				log(`[WorkspaceGuard][${phaseLabel}] WARN ${w.code}: ${w.message}`);
			}
		}
		if (check.status === "corrupted" && opts.webhook) {
			await sendDaemonWebhook(
				opts.webhook,
				opts.root,
				buildWebhookEventPayload("workspace_corrupted", opts, stateObj, genNum, {
					phaseLabel,
					warnings: check.warnings,
				}),
			);
		}
		return check;
	};
	await reportIntegrityAlerts("startup", 0, initialState);

	const rawBackoff = Number(process.env.NUWA_DAEMON_BACKOFF_MS ?? 2000);
	const baseBackoffMs = Number.isFinite(rawBackoff) && rawBackoff >= 0 ? rawBackoff : 2000;
	const rawMaxErr = Number(process.env.NUWA_DAEMON_MAX_ERRORS ?? 5);
	const maxConsecutiveErrors = Number.isFinite(rawMaxErr) && rawMaxErr >= 1 ? Math.floor(rawMaxErr) : 5;
	const rawPausePoll = Number(process.env.NUWA_PAUSE_POLL_MS ?? DEFAULT_PAUSE_POLL_MS);
	const pausePollMs = Number.isFinite(rawPausePoll) && rawPausePoll >= 20 ? Math.floor(rawPausePoll) : DEFAULT_PAUSE_POLL_MS;

	const rawGenTimeoutEnv = (process.env.NUWA_GEN_TIMEOUT_MS ?? "").trim();
	const parsedGenTimeoutEnv = rawGenTimeoutEnv ? Number(rawGenTimeoutEnv) : NaN;
	const genTimeoutMs =
		Number.isFinite(parsedGenTimeoutEnv) && parsedGenTimeoutEnv > 0
			? parsedGenTimeoutEnv
			: opts.genTimeoutMinutes * 60_000;

	const rawIdleTimeoutEnv = (process.env.NUWA_DAEMON_IDLE_MS ?? "").trim();
	const parsedIdleTimeoutEnv = rawIdleTimeoutEnv ? Number(rawIdleTimeoutEnv) : NaN;
	const idleTimeoutMs =
		Number.isFinite(parsedIdleTimeoutEnv) && parsedIdleTimeoutEnv >= 0
			? parsedIdleTimeoutEnv
			: opts.idleTimeoutMinutes * 60_000;

	const startedAt = Date.now();
	const maxDurationMs = opts.maxHours * 3600_000;
	let activeChild = null;
	let shuttingDown = false;

	const handleSignal = (sig, code) => {
		if (shuttingDown) return;
		shuttingDown = true;
		log(`收到信号 ${sig}，正在级联回收子进程组并退出...`);
		if (activeChild?.pid) {
			const cPid = Number(activeChild.pid);
			const cPgid = probePgidDaemon(cPid) ?? cPid;
			if (!killPidOrGroupSafeDaemon(cPid, cPgid, "SIGTERM")) {
				try {
					activeChild.kill("SIGTERM");
				} catch {
					/* 子进程可能已结束 */
				}
			}
		}
		cleanupTrackedProcessesDaemon(opts.root, { graceMs: 400, reason: `signal:${sig}` });
		process.exit(code);
	};
	process.on("SIGINT", () => handleSignal("SIGINT", 130));
	process.on("SIGTERM", () => handleSignal("SIGTERM", 143));
	process.on("SIGHUP", () => handleSignal("SIGHUP", 129));

	// 软暂停优雅挂起等待器（Issue #44 / NW-24）：检测 paused.json 为 true 时挂起不强停，解除即恢复
	const waitWhilePaused = async (genNum) => {
		if (!isDaemonPaused(opts.root)) return "active";
		const pState = readDaemonPausedState(opts.root);
		log(`检测到软暂停标记 (reason=${pState?.reason || "未填写"})，进入优雅挂起等待恢复（非强停）...`);
		await sendDaemonWebhook(
			opts.webhook,
			opts.root,
			buildWebhookEventPayload("paused", opts, readDiskState(opts.root), genNum, {
				reason: pState?.reason || "manual pause",
			}),
		);
		while (!shuttingDown && Date.now() - startedAt < maxDurationMs) {
			if (!isDaemonPaused(opts.root)) {
				log("检测到软暂停已解除，立即恢复执行。");
				await sendDaemonWebhook(
					opts.webhook,
					opts.root,
					buildWebhookEventPayload("resumed", opts, readDiskState(opts.root), genNum, {}),
				);
				return "resumed";
			}
			const stDuringPause = readDiskState(opts.root);
			if (stDuringPause?.project?.status === "completed") return "completed";
			if (stDuringPause?.project?.status === "stopped" && !isReincarnateStop(stDuringPause)) return "stopped";
			sweepSubagentWatchdogDaemon(opts.root);
			await Bun.sleep(pausePollMs);
		}
		return "timeout";
	};

	let gen = 1;
	let consecutiveErrors = 0;

	while (gen <= opts.maxGenerations && Date.now() - startedAt < maxDurationMs) {
		// 巡检子代理看门狗并处理软暂停
		sweepSubagentWatchdogDaemon(opts.root);
		const pauseResult = await waitWhilePaused(gen);
		if (shuttingDown) return;
		if (pauseResult === "timeout") break;

		const preState = readDiskState(opts.root);
		if (preState?.project?.status === "completed") {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "project_completed" });
			const summary = formatCompletionSummary(opts.root, preState, gen, startedAt);
			log(summary);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, preState, gen, { summary }));
			process.exit(0);
		}
		if (preState?.project?.status === "stopped" && !isReincarnateStop(preState)) {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "project_stopped" });
			const reason = preState.project?.stopReason ?? "未记录";
			log(`项目已停机 (status=stopped)，原因: ${reason}`);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, preState, gen, { reason }));
			process.exit(2);
		}
		const preBudget = checkBudgetCap(preState, opts);
		if (preBudget.exceeded) {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "budget_exceeded" });
			log(`预算上限已触发：${preBudget.reason}（累计 tokens=${preBudget.cumulativeTokens}, cost=$${preBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
			await sendDaemonWebhook(
				opts.webhook,
				opts.root,
				buildWebhookEventPayload("budget_exceeded", opts, preState, gen, {
					reason: preBudget.reason,
					limitKind: preBudget.kind,
					limit: preBudget.limit,
				}),
			);
			process.exit(3);
		}

		const remainingMaxHoursMs = maxDurationMs - (Date.now() - startedAt);
		if (remainingMaxHoursMs <= 0) break;
		const hardDeadlineMs = Math.max(1, Math.min(genTimeoutMs, remainingMaxHoursMs));
		const deadlineIsMaxHours = remainingMaxHoursMs <= genTimeoutMs;

		const prompt = buildPrompt(opts, preState, gen);
		const ompArgs = buildOmpArgs(opts, prompt);
		const childEnv = buildChildEnv(opts, gen);
		const hasHandoff = Boolean(preState?.runtime?.handoffSummary);
		log(
			`启动第 ${gen}/${opts.maxGenerations} 代会话 (${hasHandoff ? "换代交接" : preState ? "磁盘恢复" : "首次起跑"}) · root=${opts.root}`,
		);

		let exitCode = 1;
		let timedOut = false;
		let timeoutKind = "";
		let spawnedPid = 0;
		try {
			activeChild = Bun.spawn([opts.ompBin, ...ompArgs], {
				cwd: opts.root,
				env: childEnv,
				detached: true,
				stdin: "ignore",
				stdout: "inherit",
				stderr: "inherit",
			});
			spawnedPid = Number(activeChild.pid ?? 0);
			if (spawnedPid > 1) {
				registerTrackedProcessDaemon(opts.root, {
					pid: spawnedPid,
					pgid: spawnedPid,
					label: "omp-child",
					taskId: `gen-${gen}`,
					command: opts.ompBin,
				});
			}
			const watchRes = await awaitChildWithWatchdog(activeChild, {
				root: opts.root,
				gen,
				hardDeadlineMs,
				deadlineIsMaxHours,
				genTimeoutMs,
				idleTimeoutMs,
				maxHours: opts.maxHours,
				startedAt,
				maxDurationMs,
				isShuttingDown: () => shuttingDown,
			});
			exitCode = watchRes.exitCode;
			timedOut = watchRes.timedOut;
			timeoutKind = watchRes.timeoutKind;
		} catch (err) {
			logErr(`启动 ${opts.ompBin} 失败: ${err instanceof Error ? err.message : String(err)}`);
			exitCode = 127;
		} finally {
			if (spawnedPid > 1) {
				if (timedOut) {
					cleanupTrackedProcessesDaemon(opts.root, {
						taskId: `gen-${gen}`,
						graceMs: 300,
						reason: `gen_timeout:${timeoutKind}`,
					});
				} else {
					unregisterTrackedProcessDaemon(opts.root, spawnedPid);
				}
			}
			activeChild = null;
		}

		if (shuttingDown) return;

		// 每轮结算后巡检子代理看门狗 + 校验工作区及 .git 完好性
		sweepSubagentWatchdogDaemon(opts.root);
		const postState = readDiskState(opts.root);
		await reportIntegrityAlerts(`gen-${gen}-settle`, gen, postState);

		if (timedOut && (timeoutKind === "hard_max_hours" || Date.now() - startedAt >= maxDurationMs)) {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "hard_max_hours" });
			logErr(`已达到最大运行时长上限 (${opts.maxHours}h)，超时终止第 ${gen} 代 (exit=124)。`);
			process.exit(1);
		}

		if (postState?.project?.status === "completed") {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "project_completed" });
			const summary = formatCompletionSummary(opts.root, postState, gen, startedAt);
			log(summary);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, postState, gen, { summary }));
			process.exit(0);
		}
		if (postState?.project?.status === "stopped" && !isReincarnateStop(postState)) {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "project_stopped" });
			const reason = postState.project?.stopReason ?? "未记录";
			log(`项目已停机 (status=stopped)，原因: ${reason}`);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, postState, gen, { reason }));
			process.exit(2);
		}
		const postBudget = checkBudgetCap(postState, opts);
		if (postBudget.exceeded) {
			cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "budget_exceeded" });
			log(`预算上限已触发：${postBudget.reason}（累计 tokens=${postBudget.cumulativeTokens}, cost=$${postBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
			await sendDaemonWebhook(
				opts.webhook,
				opts.root,
				buildWebhookEventPayload("budget_exceeded", opts, postState, gen, {
					reason: postBudget.reason,
					limitKind: postBudget.kind,
					limit: postBudget.limit,
				}),
			);
			process.exit(3);
		}

		if (exitCode !== 0) {
			consecutiveErrors += 1;
			if (consecutiveErrors > maxConsecutiveErrors) {
				cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "max_errors" });
				const reason = `子进程连续异常退出 ${consecutiveErrors} 次（上限 ${maxConsecutiveErrors}）`;
				logErr(`${reason}，停止守护。`);
				await sendDaemonWebhook(
					opts.webhook,
					opts.root,
					buildWebhookEventPayload("max_errors", opts, postState, gen, {
						reason,
						consecutiveErrors,
						maxConsecutiveErrors,
						exitCode,
					}),
				);
				process.exit(1);
			}
			const delayMs = Math.min(60_000, baseBackoffMs * 2 ** (consecutiveErrors - 1));
			const remainMs = maxDurationMs - (Date.now() - startedAt);
			if (remainMs <= 0) break;
			const actualDelay = Math.min(delayMs, remainMs);
			const statusLabel = timedOut
				? `超时终止 (${timeoutKind === "idle" ? "空闲看门狗" : "单代超时"}, exit=124)`
				: `异常退出 (exit=${exitCode})`;
			log(
				`第 ${gen} 代子进程${statusLabel}，${actualDelay}ms 后按磁盘状态退避重试（连续错误 ${consecutiveErrors}/${maxConsecutiveErrors}）...`,
			);
			if (actualDelay > 0) {
				await Bun.sleep(actualDelay);
			}
			continue;
		}

		consecutiveErrors = 0;
		const nextGenHint = postState?.runtime?.handoffSummary ? "检测到交接摘要，准备拉起下一代" : "本代正常退出且任务仍活跃，准备拉起下一代";
		log(`第 ${gen} 代会话结束 (exit=0)：${nextGenHint}`);
		await sendDaemonWebhook(
			opts.webhook,
			opts.root,
			buildWebhookEventPayload("reincarnate", opts, postState, gen, {
				nextGeneration: gen + 1,
				hasHandoff: Boolean(postState?.runtime?.handoffSummary),
				reason: nextGenHint,
			}),
		);
		gen += 1;
	}

	// 循环结束前最后复核一次磁盘状态并清理所有登记子进程
	cleanupTrackedProcessesDaemon(opts.root, { graceMs: 300, reason: "daemon_loop_exit" });
	const finalState = readDiskState(opts.root);
	if (finalState?.project?.status === "completed") {
		const summary = formatCompletionSummary(opts.root, finalState, gen, startedAt);
		log(summary);
		await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, finalState, gen, { summary }));
		process.exit(0);
	}
	if (finalState?.project?.status === "stopped" && !isReincarnateStop(finalState)) {
		const reason = finalState.project?.stopReason ?? "未记录";
		log(`项目已停机 (status=stopped)，原因: ${reason}`);
		await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, finalState, gen, { reason }));
		process.exit(2);
	}
	const finalBudget = checkBudgetCap(finalState, opts);
	if (finalBudget.exceeded) {
		log(`预算上限已触发：${finalBudget.reason}（累计 tokens=${finalBudget.cumulativeTokens}, cost=$${finalBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
		await sendDaemonWebhook(
			opts.webhook,
			opts.root,
			buildWebhookEventPayload("budget_exceeded", opts, finalState, gen, {
				reason: finalBudget.reason,
				limitKind: finalBudget.kind,
				limit: finalBudget.limit,
			}),
		);
		process.exit(3);
	}

	const elapsedMs = Date.now() - startedAt;
	if (elapsedMs >= maxDurationMs) {
		logErr(`已达到最大运行时长上限 (${opts.maxHours}h)，任务尚未完成。`);
	} else {
		logErr(`已达到最大世代上限 (${opts.maxGenerations})，任务尚未完成。`);
	}
	process.exit(1);
}

await main();
