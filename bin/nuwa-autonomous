const VALID_MODES = new Set(["ctf", "pentest", "audit", "coding", "ops"]);
const VALID_SANDBOX_MODES = new Set(["none", "docker", "sidecar"]);
const REINCARNATE_STOP_RE = /(reincarnat|handoff|generation|换代)/i;

const DEFAULT_GEN_TIMEOUT_MINUTES = 45;
const DEFAULT_IDLE_TIMEOUT_MINUTES = 0;
const WATCHDOG_SIGKILL_GRACE_MS = 1500;
const MAX_SET_TIMEOUT_MS = 2_147_483_647;
const DEFAULT_USD_PER_1M_TOKENS = 3.0;
const DEFAULT_PAUSE_POLL_MS = 1000;
const DEFAULT_SUBAGENT_IDLE_TIMEOUT_MS = 300_000;
const DEFAULT_SUBAGENT_HARD_TIMEOUT_MS = 900_000;

function extractCliAgentHome(argv) {
	for (let i = 0; i < argv.length; i += 1) {
		const a = String(argv[i] ?? "");
		if (a === "--agent-home" && i + 1 < argv.length) return String(argv[i + 1] ?? "").trim();
		if (a.startsWith("--agent-home=")) return a.slice("--agent-home=".length).trim();
	}
	return "";
}

function resolveAutonomousDoctorModulePath(argv = process.argv.slice(2)) {
	const candidates = [];
	const cliHome = extractCliAgentHome(argv);
	if (cliHome) {
		candidates.push(join(resolve(cliHome), "nuwa-core", "core", "autonomous-doctor.ts"));
	}
	const envCore = (process.env.NUWA_CORE_DIR ?? "").trim();
	if (envCore) {
		candidates.push(join(resolve(envCore), "core", "autonomous-doctor.ts"));
	}
	const envAgentHome = (process.env.PI_AGENT_HOME ?? "").trim();
	if (envAgentHome) {
		candidates.push(join(resolve(envAgentHome), "nuwa-core", "core", "autonomous-doctor.ts"));
	}
	candidates.push(resolve(import.meta.dir, "..", "core", "autonomous-doctor.ts"));
	try {
		const realSelfDir = dirname(realpathSync(import.meta.path));
		candidates.push(resolve(realSelfDir, "..", "core", "autonomous-doctor.ts"));
	} catch {
		/* ignore */
	}
	// 兼容独立沙盒安装目录（读取同目录 nuwa-mcp 启动包装器内记录的 CORE_DIR）
	try {
		const siblingMcp = join(import.meta.dir, "nuwa-mcp");
		if (existsSync(siblingMcp)) {
			const mcpSrc = readFileSync(siblingMcp, "utf8");
			const m = /exec\s+"([^"]+)\/bin\/nuwa-mcp"/.exec(mcpSrc);
			if (m?.[1]) {
				candidates.push(join(resolve(m[1]), "core", "autonomous-doctor.ts"));
			}
		}
	} catch {
		/* ignore */
	}
	candidates.push(join(homedir(), ".omp", "agent", "nuwa-core", "core", "autonomous-doctor.ts"));
	candidates.push(join(homedir(), ".pi", "agent", "nuwa-core", "core", "autonomous-doctor.ts"));

	for (const cand of candidates) {
		if (cand && existsSync(cand)) return cand;
	}
	throw new Error(
		`未找到 core/autonomous-doctor.ts（已探测仓库相对路径与安装目录: ${candidates.slice(0, 5).join(", ")}）`,
	);
}

const doctorMod = await import(pathToFileURL(resolveAutonomousDoctorModulePath()).href);
