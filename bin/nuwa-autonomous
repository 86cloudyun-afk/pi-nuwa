function log(msg) {
	console.log(`[nuwa-autonomous] ${msg}`);
}

function logErr(msg) {
	console.error(`[nuwa-autonomous] ERROR: ${msg}`);
}

function parsePositiveNumber(name, raw, integerOnly = false) {
	if (String(raw ?? "").trim() === "") {
		throw new Error(`参数 ${name} 必须为正${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	const n = Number(raw);
	if (!Number.isFinite(n) || n <= 0 || (integerOnly && !Number.isInteger(n))) {
		throw new Error(`参数 ${name} 必须为正${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	return n;
}

function parseNonNegativeNumber(name, raw, integerOnly = false) {
	if (String(raw ?? "").trim() === "") {
		throw new Error(`参数 ${name} 必须为非负${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	const n = Number(raw);
	if (!Number.isFinite(n) || n < 0 || (integerOnly && !Number.isInteger(n))) {
		throw new Error(`参数 ${name} 必须为非负${integerOnly ? "整" : ""}数，实际收到: ${raw}`);
	}
	return n;
}

function parseEnvNonNegativeNumber(name, fallback, integerOnly = false) {
	const raw = (process.env[name] ?? "").trim();
	if (!raw) return fallback;
	const n = Number(raw);
	if (!Number.isFinite(n) || n < 0 || (integerOnly && !Number.isInteger(n))) {
		return fallback;
	}
	return n;
}

function parseEnvPositiveNumber(name, fallback) {
	const raw = (process.env[name] ?? "").trim();
	if (!raw) return fallback;
	const n = Number(raw);
	if (!Number.isFinite(n) || n <= 0) return fallback;
	return n;
}

function parseArgs(argv) {
	const opts = {
		target: "",
		mode: "ctf",
		modeExplicit: false,
		goal: "",
		root: process.cwd(),
		maxGenerations: 20,
		maxHours: 12,
		genTimeoutMinutes: DEFAULT_GEN_TIMEOUT_MINUTES,
		idleTimeoutMinutes: DEFAULT_IDLE_TIMEOUT_MINUTES,
		reincarnateTokens: 140000,
		reincarnateTurns: 30,
		maxTotalTokens: parseEnvNonNegativeNumber("NUWA_MAX_TOTAL_TOKENS", 0, true),
		maxUsd: parseEnvNonNegativeNumber("NUWA_MAX_USD", 0, false),
		usdPer1mTokens: parseEnvPositiveNumber("NUWA_USD_PER_1M_TOKENS", DEFAULT_USD_PER_1M_TOKENS),
		webhook: (process.env.NUWA_WEBHOOK_URL ?? "").trim(),
		allowSubdomains: false,
		allowCidrs: [],
		model: "",
		fastModel: "",
		deepModel: "",
		verifyModel: "",
		sandbox: "none",
		sandboxExplicit: false,
		sandboxImage: "",
		ompBin: "omp",
		dryRun: false,
		help: false,
	};

	const needVal = (flag, i) => {
		if (i + 1 >= argv.length) throw new Error(`参数 ${flag} 缺少取值`);
		return argv[i + 1];
	};

	for (let i = 0; i < argv.length; i += 1) {
		const raw = argv[i];
		let flag = raw;
		let inlineVal = null;
		if (raw.startsWith("--") && raw.includes("=")) {
			const idx = raw.indexOf("=");
			flag = raw.slice(0, idx);
			inlineVal = raw.slice(idx + 1);
		}
		const take = () => (inlineVal !== null ? inlineVal : needVal(flag, i++));

		switch (flag) {
			case "-h":
			case "--help":
				opts.help = true;
				break;
			case "--target":
				opts.target = take().trim();
				break;
			case "--mode":
				opts.mode = take().trim().toLowerCase();
				opts.modeExplicit = true;
				break;
			case "--goal":
				opts.goal = take().trim();
				break;
			case "--root":
				opts.root = take().trim();
				break;
			case "--max-generations":
				opts.maxGenerations = parsePositiveNumber(flag, take(), true);
				break;
			case "--max-hours":
				opts.maxHours = parsePositiveNumber(flag, take(), false);
				break;
			case "--gen-timeout-minutes":
				opts.genTimeoutMinutes = parsePositiveNumber(flag, take(), false);
				break;
			case "--idle-timeout-minutes":
				opts.idleTimeoutMinutes = parseNonNegativeNumber(flag, take(), false);
				break;
			case "--reincarnate-tokens":
				opts.reincarnateTokens = parsePositiveNumber(flag, take(), true);
				break;
			case "--reincarnate-turns":
				opts.reincarnateTurns = parsePositiveNumber(flag, take(), true);
				break;
			case "--max-total-tokens":
				opts.maxTotalTokens = parseNonNegativeNumber(flag, take(), true);
				break;
			case "--max-usd":
				opts.maxUsd = parseNonNegativeNumber(flag, take(), false);
				break;
			case "--usd-per-1m-tokens":
				opts.usdPer1mTokens = parsePositiveNumber(flag, take(), false);
				break;
			case "--webhook":
				opts.webhook = take().trim();
				break;
			case "--allow-subdomains":
				opts.allowSubdomains = true;
				break;
			case "--allow-cidr": {
				const parts = take()
					.split(",")
					.map((s) => s.trim())
					.filter(Boolean);
				for (const c of parts) {
					if (!opts.allowCidrs.includes(c)) opts.allowCidrs.push(c);
				}
				break;
			}
			case "--model":
				opts.model = take().trim();
				break;
			case "--fast-model":
				opts.fastModel = take().trim();
				break;
			case "--deep-model":
				opts.deepModel = take().trim();
				break;
			case "--verify-model":
				opts.verifyModel = take().trim();
				break;
			case "--sandbox":
				opts.sandbox = take().trim().toLowerCase();
				opts.sandboxExplicit = true;
				break;
			case "--sandbox-image":
				opts.sandboxImage = take().trim();
				if (
					!opts.sandboxImage ||
					opts.sandboxImage.includes("..") ||
					!/^[a-zA-Z0-9][a-zA-Z0-9._/:@-]{0,255}$/.test(opts.sandboxImage)
				) {
					throw new Error(`参数 --sandbox-image 取值非法: ${JSON.stringify(opts.sandboxImage)}`);
				}
				break;
			case "--omp-bin":
				opts.ompBin = take().trim() || "omp";
				break;
			case "--dry-run":
				opts.dryRun = true;
				break;
			default:
				throw new Error(`未知参数: ${raw}（使用 --help 查看用法）`);
		}
	}

	if (!VALID_MODES.has(opts.mode)) {
		throw new Error(`不支持的 --mode: ${opts.mode}（可选: ${[...VALID_MODES].join(", ")}）`);
	}
	if (!VALID_SANDBOX_MODES.has(opts.sandbox)) {
		throw new Error(`不支持的 --sandbox: ${opts.sandbox}（可选: none, docker, sidecar）`);
	}
	if (!opts.help && opts.webhook) {
		let parsedWebhook;
		try {
			parsedWebhook = new URL(opts.webhook);
		} catch {
			throw new Error(`参数 --webhook 不是合法 URL`);
		}
		if (!["http:", "https:"].includes(parsedWebhook.protocol) || !parsedWebhook.hostname) {
			throw new Error(`参数 --webhook 仅支持 http/https URL`);
		}
	}
	opts.root = resolve(opts.root || process.cwd());
	return opts;
}

function parseDoctorArgs(argv) {
	const opts = {
		json: false,
		help: false,
		agentHome: "",
		ompBin: (process.env.NUWA_OMP_BIN ?? "").trim() || "omp",
		bunBin: (process.env.NUWA_DOCTOR_BUN_BIN ?? "").trim() || "bun",
		kbDb: "",
		sandbox: "none",
		sandboxImage: (process.env.NUWA_SANDBOX_IMAGE ?? "").trim() || "nuwa-sandbox:latest",
		dockerBin: (process.env.NUWA_DOCKER_BIN ?? "").trim() || "docker",
	};

	const needVal = (flag, i) => {
		if (i + 1 >= argv.length) throw new Error(`参数 ${flag} 缺少取值`);
		return argv[i + 1];
	};

	for (let i = 0; i < argv.length; i += 1) {
		const raw = argv[i];
		let flag = raw;
		let inlineVal = null;
		if (raw.startsWith("--") && raw.includes("=")) {
			const idx = raw.indexOf("=");
			flag = raw.slice(0, idx);
			inlineVal = raw.slice(idx + 1);
		}
		const take = () => (inlineVal !== null ? inlineVal : needVal(flag, i++));

		switch (flag) {
			case "-h":
			case "--help":
				opts.help = true;
				break;
			case "--json":
				opts.json = true;
				break;
			case "--agent-home":
				opts.agentHome = take().trim();
				break;
			case "--omp-bin":
				opts.ompBin = take().trim() || "omp";
				break;
			case "--bun-bin":
				opts.bunBin = take().trim() || "bun";
				break;
			case "--kb-db":
				opts.kbDb = take().trim();
				break;
			case "--sandbox":
				opts.sandbox = take().trim().toLowerCase();
				break;
			case "--sandbox-image":
				opts.sandboxImage = take().trim() || "nuwa-sandbox:latest";
				break;
			case "--docker-bin":
				opts.dockerBin = take().trim() || "docker";
				break;
			default:
				throw new Error(`doctor 未知参数: ${raw}（使用 nuwa-autonomous doctor --help 查看用法）`);
		}
	}

	if (!VALID_SANDBOX_MODES.has(opts.sandbox)) {
		throw new Error(`doctor 不支持的 --sandbox: ${opts.sandbox}（可选: none, docker, sidecar）`);
	}
	return opts;
}

function resolveExecutable(binName) {
	const name = String(binName ?? "").trim();
	if (!name) return null;
	if (name.includes("/") || name.includes("\\")) {
		try {
			const full = resolve(name);
			if (statSync(full).isFile()) {
				accessSync(full, constants.X_OK);
				return full;
			}
		} catch {
			return null;
		}
		return null;
	}
	const pathEnv = process.env.PATH ?? "";
	for (const dir of pathEnv.split(delimiter)) {
		if (!dir) continue;
		const full = join(dir, name);
		try {
			if (statSync(full).isFile()) {
				accessSync(full, constants.X_OK);
				return full;
			}
		} catch {
			/* 继续查找下一 PATH 目录 */
		}
	}
	return null;
}

function probeBinaryVersion(binPath, versionArgs = ["--version"]) {
	try {
		const res = spawnSync(binPath, versionArgs, {
			encoding: "utf8",
			timeout: 3000,
			stdio: ["ignore", "pipe", "pipe"],
		});
		if (res.error) return null;
		const out = `${res.stdout ?? ""}\n${res.stderr ?? ""}`
			.split("\n")
			.map((s) => s.trim())
			.find(Boolean);
		return out || null;
	} catch {
		return null;
	}
}

function resolveAgentHome(overrideDir) {
	if (overrideDir && overrideDir.trim()) {
		return resolve(overrideDir.trim());
	}
	if (process.env.PI_AGENT_HOME && process.env.PI_AGENT_HOME.trim()) {
		return resolve(process.env.PI_AGENT_HOME.trim());
	}
	const ompAgent = join(homedir(), ".omp", "agent");
	if (existsSync(ompAgent)) return ompAgent;
	return join(homedir(), ".pi", "agent");
}

function checkExtensionInstallation(agentHome) {
	const extRoot = join(agentHome, "extensions");
	const extDir = join(extRoot, "nuwa-omp");
	const indexPath = join(extDir, "index.ts");
	const indexExists = existsSync(indexPath);

	let indexSrc = "";
	let version = null;
	if (indexExists) {
		try {
			indexSrc = readFileSync(indexPath, "utf8");
			const m = /export\s+const\s+VERSION\s*=\s*["']([^"']+)["']/.exec(indexSrc);
			if (m?.[1]) version = m[1];
		} catch {
			/* 无法读取 index.ts */
		}
	}

	const toolsFound = [];
	const toolsMissing = [];
	for (const tool of REQUIRED_NUWA_TOOLS) {
		const re = new RegExp(`name\\s*:\\s*["']${tool}["']`);
		if (indexSrc && re.test(indexSrc)) {
			toolsFound.push(tool);
		} else {
			toolsMissing.push(tool);
		}
	}

	const referencesSplitModules =
		/from\s+["']\.\/(?:storage|graph)(?:\.ts)?["']/.test(indexSrc) ||
		/require\s*\(\s*["']\.\/(?:storage|graph)(?:\.ts)?["']\s*\)/.test(indexSrc);
	const hasAnySplitFile = existsSync(join(extDir, "storage.ts")) || existsSync(join(extDir, "graph.ts"));
	const isLegacyMonolith =
		!referencesSplitModules &&
		!hasAnySplitFile &&
		typeof version === "string" &&
		(version === "4.0.0" || /^3\./.test(version));

	const coreModulesFound = [];
	const coreModulesMissing = [];
	for (const mod of CORE_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			coreModulesFound.push(mod);
		} else if (!isLegacyMonolith || !SPLIT_CORE_MODULES.has(mod)) {
			coreModulesMissing.push(mod);
		}
	}

	const v4ModulesFound = [];
	const v4ModulesMissing = [];
	for (const mod of V4_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			v4ModulesFound.push(mod);
		} else {
			v4ModulesMissing.push(mod);
		}
	}

	const v5ModulesFound = [];
	const v5ModulesMissing = [];
	for (const mod of V5_EXT_MODULES) {
		if (existsSync(join(extDir, mod))) {
			v5ModulesFound.push(mod);
		} else {
			v5ModulesMissing.push(mod);
		}
	}

	const conflicts = [];
	if (existsSync(extRoot)) {
		try {
			for (const entry of readdirSync(extRoot)) {
				if (entry.startsWith("nuwa-") && entry !== "nuwa-omp") {
					conflicts.push(entry);
				}
			}
		} catch {
			/* ignore */
		}
	}

	const ok = indexExists && toolsMissing.length === 0 && coreModulesMissing.length === 0;
	let reason = "";
	if (!indexExists) {
		reason = `未检测到已安装扩展入口 ${indexPath}（请运行 ./install.sh）`;
	} else if (toolsMissing.length > 0) {
		reason = `扩展缺少必需工具 (${toolsMissing.join(", ")})`;
	} else if (coreModulesMissing.length > 0) {
		reason = `扩展缺少核心模块 (${coreModulesMissing.join(", ")})`;
	}

	return {
		ok,
		critical: true,
		dir: extDir,
		indexExists,
		version,
		toolsCount: toolsFound.length,
		toolsRequired: REQUIRED_NUWA_TOOLS.length,
		toolsFound,
		toolsMissing,
		coreModulesFound,
		coreModulesMissing,
		v4ModulesFound,
		v4ModulesMissing,
		v5ModulesFound,
		v5ModulesMissing,
		conflicts,
		...(reason ? { reason } : {}),
	};
}

function openReadonlyKbDb(filePath) {
	let roDb = null;
	try {
		roDb = new Database(filePath, { readonly: true });
		try {
			roDb.exec("PRAGMA busy_timeout = 3000;");
		} catch {
			/* ignore */
		}
		roDb.query("SELECT 1 FROM sqlite_master LIMIT 1").get();
		return roDb;
	} catch {
		try {
			roDb?.close();
		} catch {
			/* ignore */
		}
	}

	const fallbackDb = new Database(filePath);
	try {
		fallbackDb.exec("PRAGMA busy_timeout = 3000; PRAGMA query_only = ON;");
		fallbackDb.query("SELECT 1 FROM sqlite_master LIMIT 1").get();
		return fallbackDb;
	} catch (err) {
		try {
			fallbackDb.close();
		} catch {
			/* ignore */
		}
		throw err;
	}
}

function checkKnowledgeBase(agentHome, explicitPath, explicitAgentHome = false) {
	const candidates = [];
	if (explicitPath && explicitPath.trim()) {
		candidates.push(resolve(explicitPath.trim()));
	} else if (process.env.NUWA_KB_DB && process.env.NUWA_KB_DB.trim()) {
		candidates.push(resolve(process.env.NUWA_KB_DB.trim()));
		if (explicitAgentHome) {
			candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
		}
	} else if (explicitAgentHome || (process.env.PI_AGENT_HOME && process.env.PI_AGENT_HOME.trim())) {
		candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
	} else {
		candidates.push(join(agentHome, "nuwa-kb", "kb.db"));
		candidates.push("/data/nuwa-kb/kb.db");
	}

	const foundPath = candidates.find((p) => existsSync(p)) ?? candidates[0];
	const exists = existsSync(foundPath);

	if (!exists) {
		return {
			ok: false,
			critical: false,
			path: foundPath,
			exists: false,
			counts: {},
			totalRecords: 0,
			reason: `未找到知识库文件 ${foundPath}`,
		};
	}

	const counts = {};
	let totalRecords = 0;
	let db = null;
	try {
		db = openReadonlyKbDb(foundPath);
		const existingTables = new Set(
			db
				.query("SELECT name FROM sqlite_master WHERE type IN ('table', 'view')")
				.all()
				.map((r) => String(r?.name ?? "")),
		);
		for (const table of KB_TABLES) {
			if (!existingTables.has(table)) continue;
			const row = db.query(`SELECT COUNT(*) AS cnt FROM "${table}"`).get();
			const cnt = Number(row?.cnt ?? 0);
			if (Number.isFinite(cnt)) {
				counts[table] = cnt;
				totalRecords += cnt;
			}
		}
		return {
			ok: totalRecords > 0,
			critical: false,
			path: foundPath,
			exists: true,
			counts,
			totalRecords,
			...(totalRecords === 0 ? { reason: "知识库文件存在但尚无有效记录" } : {}),
		};
	} catch (err) {
		return {
			ok: false,
			critical: false,
			path: foundPath,
			exists: true,
			counts,
			totalRecords: 0,
			reason: `读取知识库失败: ${err instanceof Error ? err.message : String(err)}`,
		};
	} finally {
		try {
			db?.close();
		} catch {
			/* ignore */
		}
	}
}

function checkAgentTemplates(agentHome) {
	const agentsDir = join(agentHome, "agents");
	const checkOne = (filename) => {
		const full = join(agentsDir, filename);
		let exists = false;
		let bytes = 0;
		try {
			const st = statSync(full);
			exists = st.isFile() && st.size > 0;
			bytes = st.size;
		} catch {
			exists = false;
		}
		return { exists, path: full, bytes };
	};

	const fujiang = checkOne("fujiang.md");
	const nuwaVerifier = checkOne("nuwa-verifier.md");
	const missing = [];
	if (!fujiang.exists) missing.push("fujiang.md");
	if (!nuwaVerifier.exists) missing.push("nuwa-verifier.md");

	return {
		ok: missing.length === 0,
		critical: false,
		dir: agentsDir,
		fujiang,
		nuwaVerifier,
		missing,
		...(missing.length > 0 ? { reason: `缺少子代理模板: ${missing.join(", ")}` } : {}),
	};
}

function checkToolchain() {
	const available = [];
	const missing = [];
	for (const tool of DOCTOR_PROBE_TOOLS) {
		if (resolveExecutable(tool)) {
			available.push(tool);
		} else {
			missing.push(tool);
		}
	}
	const hasBasic = available.includes("curl") || available.includes("python3");
	return {
		ok: hasBasic,
		critical: false,
		available,
		missing,
		...(hasBasic ? {} : { reason: "缺少基础网络/脚本工具 curl 与 python3" }),
	};
}

function checkDockerSandbox(dockerBin, image, critical) {
	const binPath = resolveExecutable(dockerBin);
	if (!binPath) {
		return {
			ok: false,
			critical,
			available: false,
			daemonRunning: false,
			image,
			imagePresent: false,
			dockerBin,
			reason: `未找到 Docker 可执行文件: ${dockerBin}`,
		};
	}

	try {
		const info = spawnSync(binPath, ["info", "--format", "{{.ServerVersion}}"], {
			encoding: "utf8",
			timeout: 3000,
			stdio: ["ignore", "pipe", "pipe"],
		});
		if (info.error || info.status !== 0) {
			const msg = info.error?.message || (info.stderr ?? "").trim() || `docker info 退出码 ${info.status}`;
			return {
				ok: false,
				critical,
				available: false,
				daemonRunning: false,
				image,
				imagePresent: false,
				dockerBin: binPath,
				reason: msg,
			};
		}

		const serverVersion = (info.stdout ?? "").trim() || undefined;
		const inspect = spawnSync(binPath, ["image", "inspect", image], {
			encoding: "utf8",
			timeout: 3000,
			stdio: ["ignore", "pipe", "pipe"],
		});
		const imagePresent = !inspect.error && inspect.status === 0;
		const ok = imagePresent;

		return {
			ok,
			critical,
			available: true,
			daemonRunning: true,
			image,
			imagePresent,
			dockerBin: binPath,
			...(serverVersion ? { serverVersion } : {}),
			...(!imagePresent ? { reason: `Docker 运行中但本地缺少沙盒镜像 ${image}` } : {}),
		};
	} catch (err) {
		return {
			ok: false,
			critical,
			available: false,
			daemonRunning: false,
			image,
			imagePresent: false,
			dockerBin: binPath,
			reason: err instanceof Error ? err.message : String(err),
		};
	}
}

function runDoctor(argv) {
	let opts;
	try {
		opts = parseDoctorArgs(argv);
	} catch (err) {
		logErr(err instanceof Error ? err.message : String(err));
		process.exit(2);
	}

	if (opts.help) {
		console.log(DOCTOR_HELP_TEXT.trimEnd());
		process.exit(0);
	}

	const agentHome = resolveAgentHome(opts.agentHome);

	// 1. 检查 bun
	const bunExplicit = opts.bunBin !== "bun";
	const bunPath = resolveExecutable(opts.bunBin) ?? (!bunExplicit ? process.execPath : null);
	const bunVersion = bunPath
		? !bunExplicit && typeof Bun !== "undefined"
			? Bun.version
			: probeBinaryVersion(bunPath, ["--version"])
		: null;
	const bunCheck = {
		ok: Boolean(bunPath),
		critical: true,
		bin: opts.bunBin,
		path: bunPath,
		version: bunVersion,
		...(!bunPath ? { reason: `未找到 bun 可执行文件: ${opts.bunBin}` } : {}),
	};

	// 2. 检查 omp
	const ompPath = resolveExecutable(opts.ompBin);
	const ompVersion = ompPath ? probeBinaryVersion(ompPath, ["--version"]) : null;
	const ompCheck = {
		ok: Boolean(ompPath),
		critical: true,
		bin: opts.ompBin,
		path: ompPath,
		version: ompVersion,
		...(!ompPath ? { reason: `未找到 omp 可执行文件: ${opts.ompBin}` } : {}),
	};

	// 3. 检查 12 工具与扩展模块
	const extensionCheck = checkExtensionInstallation(agentHome);

	// 4. 检查 KB 数据库与记录数
	const kbCheck = checkKnowledgeBase(agentHome, opts.kbDb, Boolean(opts.agentHome));

	// 5. 检查子代理模板 fujiang.md / nuwa-verifier.md
	const agentsCheck = checkAgentTemplates(agentHome);

	// 6. 检查本地工具链
	const toolchainCheck = checkToolchain();

	// 7. 检查 Docker 沙盒可用性
	const dockerCheck = checkDockerSandbox(opts.dockerBin, opts.sandboxImage, opts.sandbox === "docker" || opts.sandbox === "sidecar");

	const checks = {
		bun: bunCheck,
		omp: ompCheck,
		extension: extensionCheck,
		kb: kbCheck,
		agents: agentsCheck,
		toolchain: toolchainCheck,
		docker: dockerCheck,
	};

	const allEntries = Object.entries(checks);
	const criticalEntries = allEntries.filter(([, c]) => c.critical);
	const criticalPassed = criticalEntries.filter(([, c]) => c.ok).length;
	const criticalFailed = criticalEntries.filter(([, c]) => !c.ok).map(([k]) => k);
	const warnings = [];

	if (extensionCheck.conflicts.length > 0) {
		warnings.push(`检测到冲突扩展目录: ${extensionCheck.conflicts.join(", ")}`);
	}
	for (const [name, c] of allEntries) {
		if (!c.critical && !c.ok && c.reason) {
			warnings.push(`${name}: ${c.reason}`);
		}
	}

	const overallOk = criticalFailed.length === 0;
	const exitCode = overallOk ? 0 : 1;

	const report = {
		ok: overallOk,
		exitCode,
		checkedAt: new Date().toISOString(),
		agentHome,
		checks,
		summary: {
			criticalPassed,
			criticalTotal: criticalEntries.length,
			criticalFailed,
			warnings,
		},
	};

	if (opts.json) {
		console.log(JSON.stringify(report, null, 2));
		process.exit(exitCode);
	}

	const badge = (c) => (c.ok ? "[OK]" : c.critical ? "[FAIL]" : "[WARN]");
	const lines = [
		`女娲环境健康体检 (nuwa-autonomous doctor)`,
		`Agent Home: ${agentHome}`,
		`------------------------------------------------------------`,
		`${badge(bunCheck)} bun: ${bunCheck.ok ? `${bunCheck.version ?? "ok"} (${bunCheck.path})` : bunCheck.reason}`,
		`${badge(ompCheck)} omp: ${ompCheck.ok ? `${ompCheck.version ?? "ok"} (${ompCheck.path})` : ompCheck.reason}`,
		`${badge(extensionCheck)} 扩展与工具: ${
			extensionCheck.ok
				? `v${extensionCheck.version ?? "?"} · 工具 ${extensionCheck.toolsCount}/${extensionCheck.toolsRequired} · 核心模块 ${extensionCheck.coreModulesFound.length}/${extensionCheck.coreModulesFound.length + extensionCheck.coreModulesMissing.length} · v4模块 ${extensionCheck.v4ModulesFound.length}/${V4_EXT_MODULES.length} · v5模块 ${extensionCheck.v5ModulesFound.length}/${V5_EXT_MODULES.length}`
				: extensionCheck.reason
		}`,
		`${badge(kbCheck)} 知识库 KB: ${
			kbCheck.exists
				? `${kbCheck.path} (总记录 ${kbCheck.totalRecords}；${Object.entries(kbCheck.counts)
						.map(([k, v]) => `${k}=${v}`)
						.join(", ") || "无表"})`
				: kbCheck.reason
		}`,
		`${badge(agentsCheck)} 子代理模板: fujiang.md=${agentsCheck.fujiang.exists ? "就绪" : "缺失"}, nuwa-verifier.md=${agentsCheck.nuwaVerifier.exists ? "就绪" : "缺失"} (${agentsCheck.dir})`,
		`${badge(toolchainCheck)} 本地工具链: 可用 ${toolchainCheck.available.length}/${DOCTOR_PROBE_TOOLS.length} (${toolchainCheck.available.join(", ") || "无"})${
			toolchainCheck.missing.length ? ` | 缺失: ${toolchainCheck.missing.join(", ")}` : ""
		}`,
		`${badge(dockerCheck)} Docker 沙盒: ${
			dockerCheck.ok
				? `就绪 (daemon ${dockerCheck.serverVersion ?? "ok"}, 镜像 ${dockerCheck.image})`
				: dockerCheck.reason
		}`,
		`------------------------------------------------------------`,
		overallOk
			? `体检结论: 核心依赖就绪 (${criticalPassed}/${criticalEntries.length})${warnings.length ? `，存在 ${warnings.length} 项非阻断提醒` : ""}。`
			: `体检结论: 缺失核心依赖 (${criticalFailed.join(", ")})，请先修复后再运行。`,
	];
	console.log(lines.join("\n"));
	process.exit(exitCode);
}

function stateFilePath(root) {
	return join(root, ".nuwa", "state.json");
}

function reportFilePath(root) {
	return join(root, ".nuwa", "REPORT.md");
}

function readDiskState(root) {
	const p = stateFilePath(root);
	if (!existsSync(p)) return null;
	try {
		const parsed = JSON.parse(readFileSync(p, "utf8"));
		if (parsed && typeof parsed === "object" && parsed.project) return parsed;
		return null;
	} catch {
		return null;
	}
}

function isReincarnateStop(state) {
	if (!state || state.project?.status !== "stopped") return false;
	const stopReason = String(state.project?.stopReason ?? "");
	if (REINCARNATE_STOP_RE.test(stopReason)) return true;
	if (state.runtime?.reincarnatePending === true) return true;
	return false;
}

function defaultGoalFor(mode, target) {
	switch (mode) {
		case "coding":
			return `对 ${target} 完成自主代码分析、实现与全量测试验证`;
		case "ops":
			return `对 ${target} 完成服务巡检、故障定位与恢复验收`;
		case "audit":
			return `对 ${target} 完成安全审计并输出可复验风险证据`;
		case "pentest":
			return `对 ${target} 完成授权渗透评估并留存完整证据链`;
		case "ctf":
		default:
			return `对 ${target} 完成完整评估并取得验证 flag`;
	}
}

function buildChildEnv(opts, gen) {
	const env = {
		...process.env,
		NUWA_LOOP: "1",
		NUWA_INFINITE: "1",
		NUWA_HEADLESS_DAEMON: "1",
		NUWA_STRICT_EVIDENCE: "1",
		NUWA_REINCARNATE_TOKENS: String(opts.reincarnateTokens),
		NUWA_REINCARNATE_TURNS: String(opts.reincarnateTurns),
		NUWA_PROJECT: opts.root,
		NUWA_GENERATION: String(gen),
	};
	delete env.NUWA_WEBHOOK_URL;
	if (opts.target) {
		env.NUWA_TARGET = opts.target;
	}
	if (opts.allowSubdomains) {
		env.NUWA_SCOPE_ALLOW_SUBDOMAINS = "1";
	}
	if (opts.allowCidrs.length > 0) {
		env.NUWA_SCOPE_ALLOW_CIDRS = opts.allowCidrs.join(",");
	}
	if (opts.sandboxExplicit || opts.sandbox !== "none") {
		env.NUWA_SANDBOX = opts.sandbox;
	}
	if (opts.sandboxImage) {
		env.NUWA_SANDBOX_IMAGE = opts.sandboxImage;
	}
	if (opts.fastModel) {
		env.NUWA_MODEL_FAST = opts.fastModel;
	}
	if (opts.deepModel) {
		env.NUWA_MODEL_DEEP = opts.deepModel;
	}
	if (opts.verifyModel) {
		env.NUWA_MODEL_VERIFY = opts.verifyModel;
	}
	return env;
}

function buildPrompt(opts, state, gen) {
	const target = state?.project?.url || state?.project?.target || opts.target;
	const mode = state?.project?.mode || opts.mode;
	const goal = state?.project?.goal || opts.goal || defaultGoalFor(mode, target);
	const phase = state?.project?.phase || "recon";
	const stateGen = Number(state?.runtime?.generation ?? 0);
	const displayGen = Math.max(gen, stateGen || 1);
	const handoff = typeof state?.runtime?.handoffSummary === "string" ? state.runtime.handoffSummary.trim() : "";

	if (handoff) {
		return [
			`[女娲无头守护 · 第 ${displayGen} 代交接接力]`,
			`目标: ${target} (mode=${mode})`,
			`项目根目录: ${opts.root}`,
			`当前阶段: ${phase} · 世代: G${displayGen}`,
			``,
			`上一代交接摘要:`,
			handoff,
			``,
			`接力指令:`,
			`1. 先调用 nuwa_init(root=${JSON.stringify(opts.root)}, resume=true, force=true) 接管当前无头会话所有权，再调 nuwa_status 确认最新盘面。`,
			`2. 严格沿用交接摘要中的关键事实与避坑经验，继续通过 nuwa_frontier → nuwa_claim → task(agent="fujiang") → nuwa_commit 推进，避免重复已证伪路径。`,
			`3. 目标达成后调用 nuwa_complete 验收并执行 nuwa_report(write=true) 生成最终报告；未验收前不得自行停机。`,
		].join("\n");
	}

	if (state) {
		const factCount = Object.keys(state.facts ?? {}).length;
		const openCount = Object.values(state.intents ?? {}).filter((i) => i.status === "open" || i.status === "claimed").length;
		return [
			`[女娲无头守护 · 第 ${displayGen} 代恢复起跑]`,
			`目标: ${target} (mode=${mode}) — ${goal}`,
			`项目根目录: ${opts.root}`,
			`当前磁盘状态: phase=${phase} facts=${factCount} open/claimed=${openCount}`,
			``,
			`恢复指令:`,
			`1. 立即调用 nuwa_init(root=${JSON.stringify(opts.root)}, resume=true, force=true) 接管会话所有权并确认 nuwa_status。`,
			`2. 继续推进未完成 frontier 意图，证据全部经真实命令回显入账。`,
			`3. 达成验收条件后调用 nuwa_complete 与 nuwa_report(write=true) 收尾。`,
		].join("\n");
	}

	return [
		`[女娲无头守护 · 第 ${displayGen} 代首次起跑]`,
		`目标: ${target} (mode=${mode}) — ${goal}`,
		`项目根目录: ${opts.root}`,
		``,
		`起跑指令:`,
		`1. 立即调用 nuwa_init(target=${JSON.stringify(target)}, mode=${JSON.stringify(mode)}, goal=${JSON.stringify(goal)}, root=${JSON.stringify(opts.root)}, autoStart=true) 初始化女娲项目（若目录已有同目标项目则使用 resume=true, force=true 接管）。`,
		`2. 按女娲纪律持续推进（nuwa_frontier → nuwa_claim → task(agent="fujiang") → nuwa_commit / nuwa_flag），所有结论必须附带真实执行命令与关键回显。`,
		`3. 目标完成后调用 nuwa_complete 验收并执行 nuwa_report(write=true) 输出报告；未完成前不得输出收工结论。`,
	].join("\n");
}

function buildOmpArgs(opts, prompt) {
	const args = ["-p", "--cwd", opts.root];
	if (opts.model) {
		args.push("--model", opts.model);
	}
	args.push("--", prompt);
	return args;
}

function formatCompletionSummary(root, state, gen, startedAt) {
	const facts = Object.values(state.facts ?? {});
	const flags = facts.filter((f) => f.kind === "flag").length;
	const vulns = facts.filter((f) => f.kind === "vuln").length;
	const loots = facts.filter((f) => f.kind === "loot").length;
	const elapsedSec = Math.max(0, Math.round((Date.now() - startedAt) / 1000));
	const reportPath = reportFilePath(root);
	const reportHint = existsSync(reportPath) ? `${reportPath}（已生成）` : `${reportPath}（未写入，可运行 nuwa_report 生成）`;
	return [
		`任务已完成 (status=completed)`,
		`  项目: ${state.project?.id ?? "-"} (${state.project?.url ?? state.project?.target ?? "-"})`,
		`  模式: ${state.project?.mode ?? "-"} · 阶段: ${state.project?.phase ?? "-"} · 守护世代: ${gen} (state.gen=${state.runtime?.generation ?? 1})`,
		`  耗时: ${elapsedSec}s · 事实: ${facts.length} (flag=${flags}, vuln=${vulns}, loot=${loots})`,
		`  报告: ${reportHint}`,
	].join("\n");
}

function maskWebhookUrl(rawUrl) {
	const text = String(rawUrl ?? "").trim();
	if (!text) return "";
	try {
		const u = new URL(text);
		const origin = `${u.protocol}//${u.host}`;
		const segs = u.pathname.split("/").filter(Boolean);
		if (segs.length >= 2) {
			return `${origin}/${segs[0]}/***`;
		}
		if (segs.length === 1) {
			const seg = segs[0];
			const looksSecret = seg.length >= 16 || /[0-9a-f]{10,}|[A-Za-z0-9_-]{20,}/i.test(seg);
			const pathPart = looksSecret ? "/***" : `/${seg}`;
			return u.search ? `${origin}${pathPart}?***` : `${origin}${pathPart}`;
		}
		return u.search ? `${origin}/?***` : origin;
	} catch {
		return "***";
	}
}

function collectVaultSecretStrings(root) {
	if (!root) return [];
	const vaultPath = join(root, ".nuwa", "sessions", "vault.json");
	if (!existsSync(vaultPath)) return [];
	try {
		const parsed = JSON.parse(readFileSync(vaultPath, "utf8"));
		const roles = parsed?.roles;
		if (!roles || typeof roles !== "object") return [];
		const secrets = new Set();
		const pushVal = (v, minLen = 4) => {
			const s = String(v ?? "").trim();
			if (s.length >= minLen) secrets.add(s);
		};
		for (const entry of Object.values(roles)) {
			if (!entry || typeof entry !== "object") continue;
			if (typeof entry.bearer === "string") {
				pushVal(entry.bearer, 4);
				const bare = entry.bearer.replace(/^(?:Bearer|Token|Basic|JWT)\s+/i, "").trim();
				if (bare) pushVal(bare, 4);
			}
			if (typeof entry.cookie === "string") {
				pushVal(entry.cookie, 4);
				for (const part of entry.cookie.split(";")) {
					const eq = part.indexOf("=");
					if (eq > 0) pushVal(part.slice(eq + 1), 4);
				}
			}
			if (typeof entry.password === "string") {
				pushVal(entry.password, 3);
				if (typeof entry.username === "string" && entry.username.trim()) {
					pushVal(Buffer.from(`${entry.username}:${entry.password}`, "utf8").toString("base64"), 4);
				}
			}
			if (entry.headers && typeof entry.headers === "object") {
				for (const [hk, hv] of Object.entries(entry.headers)) {
					if (/(?:auth|token|key|secret|cookie|session|jwt|csrf|pass|cred|bearer)/i.test(hk)) {
						pushVal(hv, 4);
						const bare = String(hv ?? "").replace(/^(?:Bearer|Token|Basic|JWT)\s+/i, "").trim();
						if (bare) pushVal(bare, 4);
					}
				}
			}
		}
		return [...secrets].sort((a, b) => b.length - a.length);
	} catch {
		return [];
	}
}

function redactSecretPatterns(text, vaultSecrets = []) {
	let out = String(text ?? "");
	if (!out) return out;
	for (const secret of vaultSecrets) {
		if (secret && out.includes(secret)) {
			out = out.split(secret).join("***");
		}
	}
	out = out
		.replace(/(Authorization\s*:\s*(?:Bearer|Token|Basic|JWT)\s+)[^\s'",;\r\n]+/gi, "$1***")
		.replace(/\b(Bearer|Token|Basic|JWT)\s+[A-Za-z0-9._~+/=-]{6,}/gi, "$1 ***")
		.replace(/\beyJ[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{4,}\b/g, "eyJ***")
		.replace(/\b(?:sk-[A-Za-z0-9_-]{8,}|ak_[A-Za-z0-9_-]{8,}|ghp_[A-Za-z0-9]{10,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{16,})\b/g, "***")
		.replace(
			/\b((?:password|passwd|pass|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|token|cookie)\s*[:=]\s*)(?:"[^"\r\n]*"|'[^'\r\n]*'|[^\s,;'"\r\n]+)/gi,
			"$1***",
		)
		.replace(/(https?:\/\/)[^/\s@]+:[^/\s@]+@/gi, "$1***@")
		.replace(/([?&](?:token|key|secret|auth|sig|password|pass|api_key)=)[^&\s]+/gi, "$1***");
	return out;
}

function redactWebhookPayload(value, root, vaultSecrets = collectVaultSecretStrings(root)) {
	if (typeof value === "string") {
		return redactSecretPatterns(value, vaultSecrets);
	}
	if (Array.isArray(value)) {
		return value.map((item) => redactWebhookPayload(item, root, vaultSecrets));
	}
	if (value && typeof value === "object") {
		const out = {};
		for (const [k, v] of Object.entries(value)) {
			if (v === undefined) continue;
			out[k] = redactWebhookPayload(v, root, vaultSecrets);
		}
		return out;
	}
	return value;
}

function appendWebhookDeadletter(root, entry) {
	try {
		const dir = join(root, ".nuwa");
		mkdirSync(dir, { recursive: true });
		const dlPath = join(dir, "webhook-deadletter.jsonl");
		appendFileSync(dlPath, `${JSON.stringify(entry)}\n`, { encoding: "utf8", mode: 0o600 });
		try {
			chmodSync(dlPath, 0o600);
		} catch {
			/* 非 POSIX 文件系统忽略 */
		}
	} catch {
		/* 写死信队列失败不崩溃守护进程 */
	}
}

async function sendDaemonWebhook(webhookUrl, root, payload, opts = {}) {
	const targetUrl = String(webhookUrl ?? "").trim();
	if (!targetUrl) return { ok: false, skipped: true };

	const redactedPayload = redactWebhookPayload(payload, root);
	const body = JSON.stringify(redactedPayload);
	const maskedUrl = maskWebhookUrl(targetUrl);
	const timeoutMs = Number.isFinite(opts.timeoutMs) && opts.timeoutMs > 0 ? opts.timeoutMs : WEBHOOK_TIMEOUT_MS;

	let retryDelays = [100, 250];
	if (Array.isArray(opts.retryDelaysMs)) {
		retryDelays = opts.retryDelaysMs;
	} else {
		const envRetry = (process.env.NUWA_WEBHOOK_RETRY_MS ?? "").trim();
		if (envRetry) {
			const parsed = Number(envRetry);
			if (Number.isFinite(parsed) && parsed >= 0) {
				retryDelays = [parsed, parsed * 2];
			}
		}
	}

	let lastError = "unknown webhook error";
	for (let attempt = 1; attempt <= WEBHOOK_MAX_ATTEMPTS; attempt += 1) {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), timeoutMs);
		try {
			const res = await fetch(targetUrl, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					"User-Agent": "pi-nuwa-autonomous/5.0",
				},
				body,
				signal: controller.signal,
			});
			if (res.ok) {
				return { ok: true, status: res.status, attempts: attempt };
			}
			lastError = `HTTP ${res.status}${res.statusText ? ` ${res.statusText}` : ""}`;
		} catch (err) {
			const rawMsg = err instanceof Error ? err.message : String(err);
			lastError = rawMsg.includes(targetUrl) ? rawMsg.split(targetUrl).join(maskedUrl) : rawMsg;
		} finally {
			clearTimeout(timer);
		}

		if (attempt < WEBHOOK_MAX_ATTEMPTS) {
			const delayMs = retryDelays[attempt - 1] ?? retryDelays[retryDelays.length - 1] ?? 100;
			if (delayMs > 0) {
				await Bun.sleep(delayMs);
			}
		}
	}

	appendWebhookDeadletter(root, {
		ts: new Date().toISOString(),
		url: maskedUrl,
		attempts: WEBHOOK_MAX_ATTEMPTS,
		error: redactSecretPatterns(lastError),
		payload: redactedPayload,
	});
	logErr(`Webhook 推送失败 (${maskedUrl}，已重试 ${WEBHOOK_MAX_ATTEMPTS} 次，已写入 .nuwa/webhook-deadletter.jsonl): ${redactSecretPatterns(lastError)}`);
	return { ok: false, attempts: WEBHOOK_MAX_ATTEMPTS, error: lastError, deadlettered: true };
}

function computeCumulativeBudget(state, opts) {
	const rt = state?.runtime ?? {};
	const baseTokens = Number(rt.totalTokens ?? 0);
	const curTokens = Number(rt.tokens ?? 0);
	const cumulativeTokens =
		(Number.isFinite(baseTokens) && baseTokens > 0 ? baseTokens : 0) +
		(Number.isFinite(curTokens) && curTokens > 0 ? curTokens : 0);
	const recordedUsd = Number(rt.totalCostUsd ?? 0);
	const cumulativeUsd =
		Number.isFinite(recordedUsd) && recordedUsd > 0
			? recordedUsd
			: (cumulativeTokens / 1_000_000) * opts.usdPer1mTokens;
	return { cumulativeTokens, cumulativeUsd };
}

function checkBudgetCap(state, opts) {
	if (!state) return { exceeded: false, cumulativeTokens: 0, cumulativeUsd: 0 };
	const { cumulativeTokens, cumulativeUsd } = computeCumulativeBudget(state, opts);
	if (opts.maxTotalTokens > 0 && cumulativeTokens >= opts.maxTotalTokens) {
		return {
			exceeded: true,
			kind: "tokens",
			limit: opts.maxTotalTokens,
			cumulativeTokens,
			cumulativeUsd,
			reason: `跨世代累计 Token 已达上限 (${cumulativeTokens} >= ${opts.maxTotalTokens})`,
		};
	}
	if (opts.maxUsd > 0 && cumulativeUsd >= opts.maxUsd) {
		return {
			exceeded: true,
			kind: "usd",
			limit: opts.maxUsd,
			cumulativeTokens,
			cumulativeUsd,
			reason: `跨世代累计费用已达上限 ($${cumulativeUsd.toFixed(4)} >= $${opts.maxUsd.toFixed(4)})`,
		};
	}
	return { exceeded: false, cumulativeTokens, cumulativeUsd };
}

function buildWebhookEventPayload(event, opts, state, gen, extra = {}) {
	const { cumulativeTokens, cumulativeUsd } = computeCumulativeBudget(state, opts);
	const facts = Object.values(state?.facts ?? {});
	const flags = facts.filter((f) => f?.kind === "flag").length;
	const confirmedVulns = facts.filter(
		(f) => f?.kind === "vuln" && f?.verifyStage !== "candidate" && f?.verifyStage !== "rejected",
	).length;
	return {
		event,
		ts: new Date().toISOString(),
		projectId: state?.project?.id ?? "",
		target: state?.project?.url || state?.project?.target || opts.target,
		mode: state?.project?.mode || opts.mode,
		phase: state?.project?.phase || "recon",
		status: state?.project?.status || "active",
		generation: gen,
		stateGeneration: Number(state?.runtime?.generation ?? gen),
		cumulativeTokens,
		cumulativeUsd: Number(cumulativeUsd.toFixed(6)),
		factsCount: facts.length,
		flags,
		confirmedVulns,
		...extra,
	};
}

function persistDaemonConfig(opts, effectiveTarget, effectiveMode, effectiveGoal) {
	try {
		const dir = join(opts.root, ".nuwa");
		mkdirSync(dir, { recursive: true });
		const cfgPath = join(dir, "daemon-config.json");
		const payload = {
			target: effectiveTarget,
			mode: effectiveMode,
			goal: effectiveGoal,
			root: opts.root,
			maxGenerations: opts.maxGenerations,
			maxHours: opts.maxHours,
			genTimeoutMinutes: opts.genTimeoutMinutes,
			idleTimeoutMinutes: opts.idleTimeoutMinutes,
			reincarnateTokens: opts.reincarnateTokens,
			reincarnateTurns: opts.reincarnateTurns,
			maxTotalTokens: opts.maxTotalTokens,
			maxUsd: opts.maxUsd,
			usdPer1mTokens: opts.usdPer1mTokens,
			webhook: opts.webhook ? maskWebhookUrl(opts.webhook) : undefined,
			allowSubdomains: opts.allowSubdomains,
			allowCidrs: opts.allowCidrs,
			model: opts.model || undefined,
			fastModel: opts.fastModel || undefined,
			deepModel: opts.deepModel || undefined,
			verifyModel: opts.verifyModel || undefined,
			sandbox: opts.sandbox,
			sandboxImage: opts.sandboxImage || undefined,
			updatedAt: new Date().toISOString(),
		};
		writeFileSync(cfgPath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
	} catch {
		/* 记录辅助配置失败不阻断守护启动 */
	}
}

function shellQuotePreview(arg) {
	return `'${String(arg).replace(/'/g, `'\\''`)}'`;
}

function formatDurationMs(ms) {
	if (ms < 1000) return `${Math.round(ms)}ms`;
	if (ms < 60_000) return `${Number((ms / 1000).toFixed(2))}s`;
	return `${Number((ms / 60_000).toFixed(2))}min`;
}

function fileActivityPart(filePath) {
	try {
		const st = statSync(filePath);
		return `${st.mtimeMs}:${st.size}:${st.ino}`;
	} catch {
		return "missing";
	}
}

function readActivitySignature(root) {
	const nuwaDir = join(root, ".nuwa");
	return `${fileActivityPart(join(nuwaDir, "journal.jsonl"))}|${fileActivityPart(join(nuwaDir, "state.json"))}`;
}

async function awaitChildWithWatchdog(child, params) {
	const {
		root,
		gen,
		hardDeadlineMs,
		deadlineIsMaxHours,
		genTimeoutMs,
		idleTimeoutMs,
		maxHours,
		startedAt,
		maxDurationMs,
		isShuttingDown,
	} = params;

	let settled = false;
	let killing = false;
	let timedOut = false;
	let timeoutKind = "";
	let timeoutReason = "";
	let hardTimer = null;
	let idleTimer = null;
	let sigkillTimer = null;

	const clearAllTimers = () => {
		if (hardTimer !== null) {
			clearTimeout(hardTimer);
			hardTimer = null;
		}
		if (idleTimer !== null) {
			clearInterval(idleTimer);
			idleTimer = null;
		}
		if (sigkillTimer !== null) {
			clearTimeout(sigkillTimer);
			sigkillTimer = null;
		}
	};

	const triggerWatchdog = (kind, reason) => {
		if (settled || killing || isShuttingDown()) return;
		killing = true;
		timedOut = true;
		timeoutKind = kind;
		timeoutReason = reason;
		if (hardTimer !== null) {
			clearTimeout(hardTimer);
			hardTimer = null;
		}
		if (idleTimer !== null) {
			clearInterval(idleTimer);
			idleTimer = null;
		}
		logErr(reason);
		try {
			child.kill("SIGTERM");
		} catch {
			/* 子进程可能已退出 */
		}
		sigkillTimer = setTimeout(() => {
			if (settled) return;
			logErr(`第 ${gen} 代子进程在 SIGTERM 后 ${WATCHDOG_SIGKILL_GRACE_MS}ms 仍未退出，发送 SIGKILL 强制终止。`);
			try {
				child.kill("SIGKILL");
			} catch {
				/* ignore */
			}
		}, WATCHDOG_SIGKILL_GRACE_MS);
	};

	// 分片调度硬截止定时器，避免超大毫秒数触发 32-bit setTimeout 溢出
	const deadlineAt = Date.now() + Math.max(1, hardDeadlineMs);
	const armHardTimer = () => {
		if (settled || killing || isShuttingDown()) return;
		const remain = deadlineAt - Date.now();
		if (remain <= 0) {
			const hitMaxHours = deadlineIsMaxHours || Date.now() - startedAt >= maxDurationMs;
			if (hitMaxHours) {
				triggerWatchdog(
					"hard_max_hours",
					`第 ${gen} 代触发总时长硬上限 (maxHours=${maxHours}h)，发送 SIGTERM 终止子进程...`,
				);
			} else {
				triggerWatchdog(
					"hard_gen",
					`第 ${gen} 代触发单代超时看门狗 (genTimeout=${formatDurationMs(genTimeoutMs)})，发送 SIGTERM 终止子进程...`,
				);
			}
			return;
		}
		hardTimer = setTimeout(armHardTimer, Math.min(remain, MAX_SET_TIMEOUT_MS));
	};
	armHardTimer();

	if (idleTimeoutMs > 0) {
		let lastSig = readActivitySignature(root);
		let lastActivityAt = Date.now();
		const pollMs = Math.max(25, Math.min(5000, Math.floor(idleTimeoutMs / 4)));
		idleTimer = setInterval(() => {
			if (settled || killing || isShuttingDown()) return;
			const curSig = readActivitySignature(root);
			if (curSig !== lastSig) {
				lastSig = curSig;
				lastActivityAt = Date.now();
				return;
			}
			if (Date.now() - lastActivityAt >= idleTimeoutMs) {
				triggerWatchdog(
					"idle",
					`第 ${gen} 代触发空闲看门狗：.nuwa/journal.jsonl 与 .nuwa/state.json 连续 ${formatDurationMs(idleTimeoutMs)} 未更新，判定挂起并发送 SIGTERM...`,
				);
			}
		}, pollMs);
	}

	try {
		const rawExitCode = await child.exited;
		settled = true;
		clearAllTimers();
		return {
			exitCode: timedOut ? 124 : rawExitCode,
			timedOut,
			timeoutKind,
			timeoutReason,
		};
	} catch (err) {
		settled = true;
		clearAllTimers();
		throw err;
	}
}

async function main() {
	const rawArgv = process.argv.slice(2);
	if (rawArgv[0] === "doctor") {
		runDoctor(rawArgv.slice(1));
		return;
	}

	let opts;
	try {
		opts = parseArgs(rawArgv);
	} catch (err) {
		logErr(err instanceof Error ? err.message : String(err));
		process.exit(2);
	}

	if (opts.help) {
		console.log(HELP_TEXT.trimEnd());
		process.exit(0);
	}

	const initialState = readDiskState(opts.root);
	if (!opts.target && !initialState) {
		logErr(`未指定 --target 且 ${stateFilePath(opts.root)} 不存在（使用 --help 查看用法）`);
		process.exit(2);
	}

	const effectiveTarget = opts.target || initialState?.project?.target || initialState?.project?.url || "";
	const effectiveMode = opts.modeExplicit ? opts.mode : initialState?.project?.mode || opts.mode;
	const effectiveGoal = opts.goal || initialState?.project?.goal || defaultGoalFor(effectiveMode, effectiveTarget);
	opts.target = effectiveTarget;
	opts.mode = effectiveMode;
	opts.goal = effectiveGoal;

	if (opts.dryRun) {
		const envPreview = buildChildEnv(opts, 1);
		const prompt = buildPrompt(opts, initialState, 1);
		const ompArgs = buildOmpArgs(opts, prompt);
		const plan = {
			dryRun: true,
			root: opts.root,
			target: effectiveTarget,
			mode: effectiveMode,
			goal: effectiveGoal,
			maxGenerations: opts.maxGenerations,
			maxHours: opts.maxHours,
			genTimeoutMinutes: opts.genTimeoutMinutes,
			idleTimeoutMinutes: opts.idleTimeoutMinutes,
			reincarnateTokens: opts.reincarnateTokens,
			reincarnateTurns: opts.reincarnateTurns,
			maxTotalTokens: opts.maxTotalTokens,
			maxUsd: opts.maxUsd,
			usdPer1mTokens: opts.usdPer1mTokens,
			webhook: opts.webhook ? maskWebhookUrl(opts.webhook) : null,
			allowSubdomains: opts.allowSubdomains,
			allowCidrs: opts.allowCidrs,
			model: opts.model || null,
			fastModel: opts.fastModel || null,
			deepModel: opts.deepModel || null,
			verifyModel: opts.verifyModel || null,
			sandbox: opts.sandbox,
			sandboxImage: opts.sandboxImage || null,
			ompBin: opts.ompBin,
			existingState: Boolean(initialState),
			env: {
				NUWA_LOOP: envPreview.NUWA_LOOP,
				NUWA_INFINITE: envPreview.NUWA_INFINITE,
				NUWA_HEADLESS_DAEMON: envPreview.NUWA_HEADLESS_DAEMON,
				NUWA_STRICT_EVIDENCE: envPreview.NUWA_STRICT_EVIDENCE,
				NUWA_REINCARNATE_TOKENS: envPreview.NUWA_REINCARNATE_TOKENS,
				NUWA_REINCARNATE_TURNS: envPreview.NUWA_REINCARNATE_TURNS,
				NUWA_PROJECT: envPreview.NUWA_PROJECT,
				...(envPreview.NUWA_SCOPE_ALLOW_SUBDOMAINS
					? { NUWA_SCOPE_ALLOW_SUBDOMAINS: envPreview.NUWA_SCOPE_ALLOW_SUBDOMAINS }
					: {}),
				...(envPreview.NUWA_SCOPE_ALLOW_CIDRS
					? { NUWA_SCOPE_ALLOW_CIDRS: envPreview.NUWA_SCOPE_ALLOW_CIDRS }
					: {}),
				...(envPreview.NUWA_SANDBOX ? { NUWA_SANDBOX: envPreview.NUWA_SANDBOX } : {}),
				...(envPreview.NUWA_SANDBOX_IMAGE ? { NUWA_SANDBOX_IMAGE: envPreview.NUWA_SANDBOX_IMAGE } : {}),
				...(envPreview.NUWA_MODEL_FAST ? { NUWA_MODEL_FAST: envPreview.NUWA_MODEL_FAST } : {}),
				...(envPreview.NUWA_MODEL_DEEP ? { NUWA_MODEL_DEEP: envPreview.NUWA_MODEL_DEEP } : {}),
				...(envPreview.NUWA_MODEL_VERIFY ? { NUWA_MODEL_VERIFY: envPreview.NUWA_MODEL_VERIFY } : {}),
			},
			command: [opts.ompBin, ...ompArgs],
		};
		log("Dry-run 规划配置:");
		console.log(JSON.stringify(plan, null, 2));
		log(`首轮命令预览: ${[opts.ompBin, ...ompArgs.slice(0, -1), "<prompt>"].map(shellQuotePreview).join(" ")}`);
		process.exit(0);
	}

	mkdirSync(opts.root, { recursive: true });
	persistDaemonConfig(opts, effectiveTarget, effectiveMode, effectiveGoal);

	const rawBackoff = Number(process.env.NUWA_DAEMON_BACKOFF_MS ?? 2000);
	const baseBackoffMs = Number.isFinite(rawBackoff) && rawBackoff >= 0 ? rawBackoff : 2000;
	const rawMaxErr = Number(process.env.NUWA_DAEMON_MAX_ERRORS ?? 5);
	const maxConsecutiveErrors = Number.isFinite(rawMaxErr) && rawMaxErr >= 1 ? Math.floor(rawMaxErr) : 5;

	const rawGenTimeoutEnv = (process.env.NUWA_GEN_TIMEOUT_MS ?? "").trim();
	const parsedGenTimeoutEnv = rawGenTimeoutEnv ? Number(rawGenTimeoutEnv) : NaN;
	const genTimeoutMs =
		Number.isFinite(parsedGenTimeoutEnv) && parsedGenTimeoutEnv > 0
			? parsedGenTimeoutEnv
			: opts.genTimeoutMinutes * 60_000;

	const rawIdleTimeoutEnv = (process.env.NUWA_DAEMON_IDLE_MS ?? "").trim();
	const parsedIdleTimeoutEnv = rawIdleTimeoutEnv ? Number(rawIdleTimeoutEnv) : NaN;
	const idleTimeoutMs =
		Number.isFinite(parsedIdleTimeoutEnv) && parsedIdleTimeoutEnv >= 0
			? parsedIdleTimeoutEnv
			: opts.idleTimeoutMinutes * 60_000;

	const startedAt = Date.now();
	const maxDurationMs = opts.maxHours * 3600_000;
	let activeChild = null;
	let shuttingDown = false;

	const handleSignal = (sig, code) => {
		if (shuttingDown) return;
		shuttingDown = true;
		log(`收到信号 ${sig}，正在停止子进程并退出...`);
		try {
			activeChild?.kill("SIGTERM");
		} catch {
			/* 子进程可能已结束 */
		}
		process.exit(code);
	};
	process.on("SIGINT", () => handleSignal("SIGINT", 130));
	process.on("SIGTERM", () => handleSignal("SIGTERM", 143));

	let gen = 1;
	let consecutiveErrors = 0;

	while (gen <= opts.maxGenerations && Date.now() - startedAt < maxDurationMs) {
		const preState = readDiskState(opts.root);
		if (preState?.project?.status === "completed") {
			const summary = formatCompletionSummary(opts.root, preState, gen, startedAt);
			log(summary);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, preState, gen, { summary }));
			process.exit(0);
		}
		if (preState?.project?.status === "stopped" && !isReincarnateStop(preState)) {
			const reason = preState.project?.stopReason ?? "未记录";
			log(`项目已停机 (status=stopped)，原因: ${reason}`);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, preState, gen, { reason }));
			process.exit(2);
		}
		const preBudget = checkBudgetCap(preState, opts);
		if (preBudget.exceeded) {
			log(`预算上限已触发：${preBudget.reason}（累计 tokens=${preBudget.cumulativeTokens}, cost=$${preBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
			await sendDaemonWebhook(
				opts.webhook,
				opts.root,
				buildWebhookEventPayload("budget_exceeded", opts, preState, gen, {
					reason: preBudget.reason,
					limitKind: preBudget.kind,
					limit: preBudget.limit,
				}),
			);
			process.exit(3);
		}

		const remainingMaxHoursMs = maxDurationMs - (Date.now() - startedAt);
		if (remainingMaxHoursMs <= 0) break;
		const hardDeadlineMs = Math.max(1, Math.min(genTimeoutMs, remainingMaxHoursMs));
		const deadlineIsMaxHours = remainingMaxHoursMs <= genTimeoutMs;

		const prompt = buildPrompt(opts, preState, gen);
		const ompArgs = buildOmpArgs(opts, prompt);
		const childEnv = buildChildEnv(opts, gen);
		const hasHandoff = Boolean(preState?.runtime?.handoffSummary);
		log(
			`启动第 ${gen}/${opts.maxGenerations} 代会话 (${hasHandoff ? "换代交接" : preState ? "磁盘恢复" : "首次起跑"}) · root=${opts.root}`,
		);

		let exitCode = 1;
		let timedOut = false;
		let timeoutKind = "";
		try {
			activeChild = Bun.spawn([opts.ompBin, ...ompArgs], {
				cwd: opts.root,
				env: childEnv,
				stdin: "ignore",
				stdout: "inherit",
				stderr: "inherit",
			});
			const watchRes = await awaitChildWithWatchdog(activeChild, {
				root: opts.root,
				gen,
				hardDeadlineMs,
				deadlineIsMaxHours,
				genTimeoutMs,
				idleTimeoutMs,
				maxHours: opts.maxHours,
				startedAt,
				maxDurationMs,
				isShuttingDown: () => shuttingDown,
			});
			exitCode = watchRes.exitCode;
			timedOut = watchRes.timedOut;
			timeoutKind = watchRes.timeoutKind;
		} catch (err) {
			logErr(`启动 ${opts.ompBin} 失败: ${err instanceof Error ? err.message : String(err)}`);
			exitCode = 127;
		} finally {
			activeChild = null;
		}

		if (shuttingDown) return;

		if (timedOut && (timeoutKind === "hard_max_hours" || Date.now() - startedAt >= maxDurationMs)) {
			logErr(`已达到最大运行时长上限 (${opts.maxHours}h)，超时终止第 ${gen} 代 (exit=124)。`);
			process.exit(1);
		}

		const postState = readDiskState(opts.root);
		if (postState?.project?.status === "completed") {
			const summary = formatCompletionSummary(opts.root, postState, gen, startedAt);
			log(summary);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, postState, gen, { summary }));
			process.exit(0);
		}
		if (postState?.project?.status === "stopped" && !isReincarnateStop(postState)) {
			const reason = postState.project?.stopReason ?? "未记录";
			log(`项目已停机 (status=stopped)，原因: ${reason}`);
			await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, postState, gen, { reason }));
			process.exit(2);
		}
		const postBudget = checkBudgetCap(postState, opts);
		if (postBudget.exceeded) {
			log(`预算上限已触发：${postBudget.reason}（累计 tokens=${postBudget.cumulativeTokens}, cost=$${postBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
			await sendDaemonWebhook(
				opts.webhook,
				opts.root,
				buildWebhookEventPayload("budget_exceeded", opts, postState, gen, {
					reason: postBudget.reason,
					limitKind: postBudget.kind,
					limit: postBudget.limit,
				}),
			);
			process.exit(3);
		}

		if (exitCode !== 0) {
			consecutiveErrors += 1;
			if (consecutiveErrors > maxConsecutiveErrors) {
				const reason = `子进程连续异常退出 ${consecutiveErrors} 次（上限 ${maxConsecutiveErrors}）`;
				logErr(`${reason}，停止守护。`);
				await sendDaemonWebhook(
					opts.webhook,
					opts.root,
					buildWebhookEventPayload("max_errors", opts, postState, gen, {
						reason,
						consecutiveErrors,
						maxConsecutiveErrors,
						exitCode,
					}),
				);
				process.exit(1);
			}
			const delayMs = Math.min(60_000, baseBackoffMs * 2 ** (consecutiveErrors - 1));
			const remainMs = maxDurationMs - (Date.now() - startedAt);
			if (remainMs <= 0) break;
			const actualDelay = Math.min(delayMs, remainMs);
			const statusLabel = timedOut
				? `超时终止 (${timeoutKind === "idle" ? "空闲看门狗" : "单代超时"}, exit=124)`
				: `异常退出 (exit=${exitCode})`;
			log(
				`第 ${gen} 代子进程${statusLabel}，${actualDelay}ms 后按磁盘状态退避重试（连续错误 ${consecutiveErrors}/${maxConsecutiveErrors}）...`,
			);
			if (actualDelay > 0) {
				await Bun.sleep(actualDelay);
			}
			continue;
		}

		consecutiveErrors = 0;
		const nextGenHint = postState?.runtime?.handoffSummary ? "检测到交接摘要，准备拉起下一代" : "本代正常退出且任务仍活跃，准备拉起下一代";
		log(`第 ${gen} 代会话结束 (exit=0)：${nextGenHint}`);
		await sendDaemonWebhook(
			opts.webhook,
			opts.root,
			buildWebhookEventPayload("reincarnate", opts, postState, gen, {
				nextGeneration: gen + 1,
				hasHandoff: Boolean(postState?.runtime?.handoffSummary),
				reason: nextGenHint,
			}),
		);
		gen += 1;
	}

	// 循环结束前最后复核一次磁盘状态
	const finalState = readDiskState(opts.root);
	if (finalState?.project?.status === "completed") {
		const summary = formatCompletionSummary(opts.root, finalState, gen, startedAt);
		log(summary);
		await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("completed", opts, finalState, gen, { summary }));
		process.exit(0);
	}
	if (finalState?.project?.status === "stopped" && !isReincarnateStop(finalState)) {
		const reason = finalState.project?.stopReason ?? "未记录";
		log(`项目已停机 (status=stopped)，原因: ${reason}`);
		await sendDaemonWebhook(opts.webhook, opts.root, buildWebhookEventPayload("stopped", opts, finalState, gen, { reason }));
		process.exit(2);
	}
	const finalBudget = checkBudgetCap(finalState, opts);
	if (finalBudget.exceeded) {
		log(`预算上限已触发：${finalBudget.reason}（累计 tokens=${finalBudget.cumulativeTokens}, cost=$${finalBudget.cumulativeUsd.toFixed(4)}），守护进程干净退出 (exit=3)。`);
		await sendDaemonWebhook(
			opts.webhook,
			opts.root,
			buildWebhookEventPayload("budget_exceeded", opts, finalState, gen, {
				reason: finalBudget.reason,
				limitKind: finalBudget.kind,
				limit: finalBudget.limit,
			}),
		);
		process.exit(3);
	}

	const elapsedMs = Date.now() - startedAt;
	if (elapsedMs >= maxDurationMs) {
		logErr(`已达到最大运行时长上限 (${opts.maxHours}h)，任务尚未完成。`);
	} else {
		logErr(`已达到最大世代上限 (${opts.maxGenerations})，任务尚未完成。`);
	}
	process.exit(1);
}

await main();
