#!/usr/bin/env bash
# nuwa <目标URL> [项目名] [--loop|--no-loop] [--detach] [--minutes N] [--parallel K] [--no-run] [--model M]
# 女娲渗透：建图 → 出意图 → 逐条 dispatch 派生子代理（默认循环到完成/预算尽）
#
# 退出码：
#   0  正常完成或预算用尽
#   2  参数/URL 错误
#   3  依赖缺失（sapper / python3 / curl）
#   4  项目目录冲突
#   5  另一个 nuwa 正在操作同一张图
set -uo pipefail

_SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
_PKG_DIR="$(cd "$_SELF_DIR/.." && pwd)"
LAB_DIR="${SAPPER_HOME:-$HOME/sapper-lab}"
export PATH="$LAB_DIR/bin:$PATH"

# R1 子命令走 Python CLI；其余参数保持旧 URL 语义
case "${1:-}" in
  ls|status|attach|budget|flag|complete|commit|recover|adopt|dispatch|run|metrics|report|verify|policy|fairness|plugin|soak|soak-night|soak-verify|migrate)
    if [[ -f "$_PKG_DIR/nuwa/cli.py" ]]; then
      # shellcheck disable=SC1090
      [[ -f "${NUWA_ENV:-$LAB_DIR/env.sh}" ]] && source "${NUWA_ENV:-$LAB_DIR/env.sh}"
      export PATH="$LAB_DIR/bin:$PATH"
      exec python3 "$_PKG_DIR/nuwa/cli.py" "$@"
    fi
    ;;
esac

NUWA_VERSION="1.2.1"

ENV_FILE="${NUWA_ENV:-$LAB_DIR/env.sh}"
# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"
# env.sh 可能重置 PATH；再压一次，确保 guard 在真实 sapper 之前。
export PATH="$LAB_DIR/bin:$PATH"

# 安装器把 omp-claude 放在 $SAPPER_HOME/bin；解析引擎，供 Python dispatch 使用。
if [[ -z "${NUWA_ENGINE:-}" ]]; then
  for _cand in "$LAB_DIR/bin/omp-claude" "omp-claude" "fake-claude"; do
    if command -v "$_cand" >/dev/null 2>&1; then NUWA_ENGINE="$_cand"; break; fi
  done
fi
export NUWA_ENGINE

# ---------------------------------------------------------------- 日志
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { printf '[%s] %s\n' "$(ts)" "$*"; }
die() { log "ERROR: $*" >&2; exit "${2:-1}"; }

need() {
  command -v "$1" >/dev/null 2>&1 || {
    log "ERROR: 缺少依赖 $1${2:+（$2）}" >&2
    exit 3
  }
}

usage() {
  cat <<'EOF'
用法: nuwa <目标URL> [项目名] [选项]

  --loop / --no-loop    循环到完成或预算尽（默认 loop）
  --detach              后台运行，日志写 <项目>/nuwa.log
  --minutes N           总预算分钟数（默认 60）
  --parallel K          并行 dispatch 数（默认 3）
  --model M             dispatch 使用的模型（默认 deepseek-flash）
  --no-run              只建图出意图，不执行
  --no-view             不启动看板
  --version             打印版本
  -h, --help            显示本帮助

环境变量:
  SAPPER_HOME           lab 目录（默认 ~/sapper-lab）
  NUWA_ENV              环境文件（默认 $SAPPER_HOME/env.sh）
  SAPPER_TIMEOUT        单次 dispatch 超时秒数（默认 300）
  NUWA_DISPATCH_TIMEOUT 覆盖单次 dispatch 超时
EOF
}

url=""; name=""; loop=1; minutes=60; parallel=3; run=1; detach=0; view=1; model="deepseek-flash"
while (( $# )); do
  case "$1" in
    --loop) loop=1; shift ;;
    --no-loop) loop=0; shift ;;
    --detach) detach=1; shift ;;
    --no-view) view=0; shift ;;
    --no-run) run=0; shift ;;
    --minutes) minutes="${2:-60}"; shift 2 ;;
    --parallel) parallel="${2:-3}"; shift 2 ;;
    --model) model="${2:-deepseek-flash}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --version) echo "nuwa $NUWA_VERSION"; exit 0 ;;
    -*) log "ERROR: 未知参数 $1（--help 查看用法）" >&2; exit 2 ;;
    *) if [[ -z "$url" ]]; then url="$1"; elif [[ -z "$name" ]]; then name="$1"; else
         log "ERROR: 多余参数 $1" >&2; exit 2; fi; shift ;;
  esac
done

[[ -n "$url" ]] || { usage >&2; exit 2; }
(( run )) || loop=0
[[ "$minutes" =~ ^[0-9]+$ ]] && (( minutes > 0 )) || die "--minutes 必须是正整数" 2
[[ "$parallel" =~ ^[0-9]+$ ]] && (( parallel > 0 )) || die "--parallel 必须是正整数" 2

# ---------------------------------------------------------------- 依赖闸门（P0-0.1）
need sapper "先装 sapper-v2: https://github.com/86cloudyun-afk/sapper-v2"
need python3
need curl

# ---------------------------------------------------------------- URL 规范化（P1-1.9）
norm="$(python3 - "$url" <<'PY'
import sys, urllib.parse as u
raw = sys.argv[1].strip()
if "://" not in raw:
    raw = "https://" + raw
p = u.urlparse(raw)
if not p.hostname:
    print("ERR", file=sys.stderr); sys.exit(2)
try:
    port = p.port
except ValueError:
    print("ERR", file=sys.stderr); sys.exit(2)
port = port or (443 if p.scheme == "https" else 80)
print(f"{p.scheme}://{p.hostname}:{port}")
print(p.hostname)
print(port)
PY
)" || die "无法解析目标 URL: $url" 2
{ read -r url_norm; read -r host; read -r port; } <<<"$norm"
[[ -n "$host" && -n "$port" ]] || die "URL 解析结果为空: $url" 2
url="$url_norm"

# ---------------------------------------------------------------- 项目目录（P1-1.10）
stamp="$(date +%m%d-%H%M)"
name="${name:-nuwa-$stamp-$$}"
dir="$LAB_DIR/$name"
if [[ -e "$dir" && ! -d "$dir" ]]; then
  die "项目路径已存在且不是目录: $dir" 4
fi
if [[ -d "$dir" && ! -d "$dir/.sapper" ]] && [[ -n "$(ls -A "$dir" 2>/dev/null | grep -v '^nuwa\.log$')" ]]; then
  # 目录存在、非空、却不是 sapper 项目：拒绝覆盖
  die "目录非空且不是 sapper 项目: $dir（换一个名字或先清理）" 4
fi
mkdir -p "$dir" || die "无法创建 $dir" 4
cd "$dir" || die "无法进入 $dir" 4

# 图损坏前置拦截：project.json 不是合法 JSON 时立刻退出，别带着坏图跑
if [[ -d .sapper ]]; then
  python3 -c 'import json; json.load(open(".sapper/project.json"))' 2>/dev/null \
    || die "图损坏：.sapper/project.json 不是合法 JSON（重建: sapper teardown --purge）" 2
fi

AGENT_HOME="${PI_AGENT_HOME:-$HOME/.omp/agent}"
[[ -d "$AGENT_HOME" ]] || AGENT_HOME="$HOME/.pi/agent"
mkdir -p "$AGENT_HOME/cache"

# 指针文件改为 JSON：root + sessionId + ts，供 nuwa-loop 校验归属（P1-1.1）
python3 - "$AGENT_HOME/cache/nuwa-current" "$dir" "${PI_SESSION_ID:-}" <<'PY'
import json, os, sys, time
path, root, sid = sys.argv[1], sys.argv[2], sys.argv[3]
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump({"root": os.path.abspath(root), "sessionId": sid, "ts": int(time.time() * 1000)}, f)
os.replace(tmp, path)
PY

# ---------------------------------------------------------------- 后台模式
if (( detach )); then
  logfile="$dir/nuwa.log"
  extra=(); (( view )) || extra+=(--no-view)
  (( run )) || extra+=(--no-run)
  (( loop )) || extra+=(--no-loop)
  nohup "$0" "$url" "$name" --minutes "$minutes" --parallel "$parallel" \
    --model "$model" "${extra[@]}" >>"$logfile" 2>&1 &
  echo "[nuwa] detached pid=$! log=$logfile dir=$dir"
  echo "[nuwa] 看板: 启动后写入 $dir/VIEW.txt"
  exit 0
fi

# ---------------------------------------------------------------- 项目锁（P1-1.2）
LOCK_FILE="$dir/.nuwa.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  holder="$(cat "$LOCK_FILE" 2>/dev/null || echo '?')"
  die "另一个 nuwa 正在操作 $dir（holder pid=$holder）" 5
fi
printf '%s\n' "$$" >"$LOCK_FILE"
# 退出时只清自己持有的锁，避免误删别人的
cleanup_lock() {
  [[ -f "$LOCK_FILE" ]] || return 0
  [[ "$(cat "$LOCK_FILE" 2>/dev/null)" == "$$" ]] && rm -f "$LOCK_FILE"
}
# TERM/INT 必须真的退出：先清锁，再收掉仍在跑的 dispatch 子进程
on_signal() {
  cleanup_lock
  local pids
  pids="$(jobs -p 2>/dev/null || true)"
  [[ -n "$pids" ]] && kill $pids 2>/dev/null
  exit 143
}
trap cleanup_lock EXIT
trap on_signal INT TERM

DISPATCH_TIMEOUT="${NUWA_DISPATCH_TIMEOUT:-${SAPPER_TIMEOUT:-300}}"
[[ "$DISPATCH_TIMEOUT" =~ ^[0-9]+$ ]] && (( DISPATCH_TIMEOUT > 0 )) || DISPATCH_TIMEOUT=300

# 结构化事件日志（P2-2.1）
EVENTS="$dir/events.jsonl"
event() {
  python3 - "$EVENTS" "$@" <<'PY' 2>/dev/null
import json, sys, time
path, kind = sys.argv[1], sys.argv[2]
rec = {"ts": time.time(), "event": kind}
for kv in sys.argv[3:]:
    if "=" in kv:
        k, v = kv.split("=", 1)
        rec[k] = v
with open(path, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec, ensure_ascii=False) + "\n")
PY
}

# ---------------------------------------------------------------- 建图
if [[ ! -d .sapper ]]; then
  sapper setup --goal "对 $url 做完整渗透评估并拿到 flag" --agents >/dev/null \
    || die "sapper setup 失败" 1
  sapper fact "靶标已授权且可达：$url" -t "靶标确认" -k host \
    -d ip="$host" -d port="$port" -d url="$url" -d status=alive >/dev/null \
    || die "sapper fact 失败" 1
  log "新图: $dir"
  event project_created "root=$dir" "url=$url" "host=$host" "port=$port"
else
  log "复用图: $dir"
  event project_reused "root=$dir"
fi

# ---------------------------------------------------------------- 看板
ensure_view() {
  local url_file="$dir/.sapper/view.url" pid_file="$dir/.sapper/view.pid" log_file="$dir/.sapper/view.log"
  if [[ -f "$url_file" ]]; then
    local old; old=$(cat "$url_file" 2>/dev/null)
    if [[ -n "$old" ]] && curl -fsS -m 2 -o /dev/null "$old" 2>/dev/null; then
      printf '%s\n' "$old" > "$dir/VIEW.txt"
      log "看板: $old"
      return 0
    fi
  fi

  local vport
  vport=$(python3 - <<'PY'
import socket
for p in range(8765, 8865):
    s = socket.socket(); s.settimeout(0.15)
    try:
        s.connect(("127.0.0.1", p)); s.close()
    except OSError:
        print(p); break
PY
)
  if [[ -z "$vport" ]]; then
    log "看板: 8765-8864 端口已满，先停一个 sapper view"
    return 1
  fi

  nohup sapper --store "$dir/.sapper" view --serve --host 127.0.0.1 --port "$vport" >"$log_file" 2>&1 &
  echo $! > "$pid_file"
  disown 2>/dev/null || true

  local vurl="http://127.0.0.1:$vport/" i
  for i in $(seq 1 24); do
    curl -fsS -m 1 -o /dev/null "$vurl" 2>/dev/null && break
    sleep 0.25
  done

  if curl -fsS -m 2 -o /dev/null "$vurl" 2>/dev/null; then
    printf '%s\n' "$vurl" > "$url_file"
    printf '%s\n' "$vurl" > "$dir/VIEW.txt"
    log "看板: $vurl"
    event view_started "url=$vurl" "pid=$(cat "$pid_file")"
  else
    log "看板: 启动失败，日志 $log_file"
    tail -4 "$log_file" 2>/dev/null
  fi
}

(( view )) && ensure_view

# ---------------------------------------------------------------- dispatch
dispatch_one() {
  local id="$1" to="$2"
  log "执行 $id (timeout=${to}s)"
  event dispatch_start "id=$id" "timeout=$to"
  local t0; t0=$(date +%s)
  local out rc
  # 默认走 Python dispatch：渲染提示 → 引擎 → 幂等提交 → 账本结算。
  # 只有显式 NUWA_SUBMIT_MODE=sapper 才走 sapper 内部提交（遗留模式，必须留痕）。
  local mode="${NUWA_SUBMIT_MODE:-cli}"
  if [[ "$mode" == "cli" ]]; then
    if [[ ! -f "$_PKG_DIR/nuwa/cli.py" || -z "${NUWA_ENGINE:-}" ]]; then
      log "ERROR: 事务提交需要 nuwa CLI 与可用引擎（NUWA_ENGINE）；仅调试可设 NUWA_SUBMIT_MODE=sapper" >&2
      event dispatch_error "id=$id" "why=no_engine"
      return 3
    fi
    out=$(PYTHONPATH="$_PKG_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 "$_PKG_DIR/nuwa/cli.py" \
      dispatch "$id" --root "$PWD" --model "$model" --timeout "$to" 2>&1) 9>&-
    rc=$?
  elif [[ "$mode" == "sapper" ]]; then
    event dispatch_legacy "id=$id" "mode=sapper"
    _tk="$(cat "$LAB_DIR/.submit_token" 2>/dev/null || true)"
    out=$(NUWA_SUBMIT_ALLOWED="$_tk" sapper dispatch "$id" --claim --model "$model" --skip-permissions --timeout "$to" 2>&1) 9>&-
    rc=$?
  else
    log "ERROR: NUWA_SUBMIT_MODE 只能是 cli 或 sapper（当前 $mode）" >&2
    return 2
  fi
  local dt=$(( $(date +%s) - t0 ))
  printf '%s\n' "$out" | tail -6
  event dispatch_end "id=$id" "rc=$rc" "dur=${dt}s"
  (( rc == 0 )) || : > "$PWD/.nuwa-dispatch-failed" 2>/dev/null || true
  return $rc
}

# frontier 只取合法 intent id（P0-0.2）
frontier_ids() {
  sapper frontier 2>/dev/null | grep -E '^i[0-9]+' | cut -f1
}

# 完成证据闸门：只有 flag/vuln/loot 事实才算真完成
has_evidence() {
  python3 -c 'import glob, json
facts = {}
for p in glob.glob(".sapper/facts/*.json"):
    if p.endswith("goal.json"):
        continue
    try:
        f = json.load(open(p)); facts[f.get("id")] = f
    except Exception:
        pass
edges = []
for p in glob.glob(".sapper/intents/*.json"):
    try:
        it = json.load(open(p))
    except Exception:
        continue
    if it.get("to") == "goal":
        edges.append(it)
if not edges:
    print("no"); raise SystemExit
for e in edges:
    if e.get("status") != "complete":
        print("no"); raise SystemExit
    refs = e.get("from") or []
    if not refs:
        print("no"); raise SystemExit
    if not all(facts.get(r, {}).get("kind") in ("flag", "vuln", "loot") for r in refs):
        print("no"); raise SystemExit
print("yes")'
}

revert_completion() {
  (
  flock -x 8 || return 1
  python3 -c 'import datetime, glob, json, os
# 先删除 to=goal 的完成边，再写 active；否则 validate 会持续报 completion edge。
for path in glob.glob(".sapper/intents/*.json"):
    try:
        it = json.load(open(path))
    except Exception:
        continue
    if it.get("to") == "goal":
        try:
            os.remove(path)
        except OSError:
            raise SystemExit(1)
p = ".sapper/project.json"
d = json.load(open(p))
d["status"] = "active"
d.pop("completed_at", None)
d.pop("completed_from", None)
d["updated_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
json.dump(d, open(p, "w"), ensure_ascii=False, indent=2)
h = ".sapper/hints.json"
try:
    hints = json.load(open(h))
except Exception:
    hints = []
hints.append({"content": "完成被拒绝：没有任何 flag/vuln/loot 事实", "creator": "nuwa", "created_at": d["updated_at"]})
json.dump(hints, open(h, "w"), ensure_ascii=False, indent=2)'
  sapper validate >/dev/null 2>&1 || log "回滚后 validate 失败"
  ) 8>"$dir/.sapper/.lock"
}

# 完成验收：返回 0 表示"真完成，应停机"；返回 1 表示继续（必要时已打回 active）
completion_ok() {
  local status
  status=$(python3 -c "import json;print(json.load(open('.sapper/project.json')).get('status',''))" 2>/dev/null)
  [[ "$status" == "completed" ]] || return 1
  if [[ "$(has_evidence)" == "yes" || "${NUWA_REQUIRE_EVIDENCE:-1}" == "0" ]]; then
    return 0
  fi
  revert_completion
  log "完成被拒绝：无证据，已打回 active"
  event completion_rejected "round=${round:-0}"
  return 1
}

# 图的推进签名：note 噪声不计入，避免空转时看起来一直"有进展"
graph_sig() {
  python3 -c '
import glob, json
p = json.load(open(".sapper/project.json"))
ints = []
for f in glob.glob(".sapper/intents/*.json"):
    try: ints.append(json.load(open(f)))
    except Exception: pass
facts = []
for f in glob.glob(".sapper/facts/*.json"):
    if f.endswith("goal.json"): continue
    try: facts.append(json.load(open(f)))
    except Exception: pass
o = sum(1 for i in ints if i.get("status") == "open")
c = sum(1 for i in ints if i.get("status") == "claimed")
d = sum(1 for i in ints if i.get("status") in ("done", "complete"))
ef = sum(1 for f in facts if f.get("kind") not in (None, "note"))
fl = sum(1 for f in facts if f.get("kind") == "flag")
print("%s|%s|%s|%s|%s|%s" % (p.get("status"), o, c, d, ef, fl))'
}

round=0
last_sig=""
stall=0
deadline=$(( $(date +%s) + minutes * 60 ))
while :; do
  round=$((round + 1))
  remaining=$(( deadline - $(date +%s) ))
  if (( remaining <= 0 )); then
    completion_ok && event project_completed "round=$round" "why=budget"
    log "预算用尽 ($minutes 分钟)"
    event budget_exhausted "minutes=$minutes"
    break
  fi

  log "===== round $round (remaining ${remaining}s) ====="
  event round_start "round=$round" "remaining=$remaining"

  # 只有 frontier 为空时才让 reason 生成新意图，省一轮模型调用
  ids="$(frontier_ids)"
  if [[ -z "$ids" ]]; then
    NUWA_SUBMIT_ALLOWED="$(cat "$LAB_DIR/.submit_token" 2>/dev/null || true)" \
      sapper dispatch reason --model "$model" --timeout "$(( remaining < 240 ? remaining : 240 ))" 2>&1 | tail -1
    ids="$(frontier_ids)"
  fi

  if [[ -z "$ids" ]]; then
    if completion_ok; then
      log "目标已完成（证据齐备）"
      event project_completed "round=$round"
      break
    fi
    log "frontier 为空"
    event frontier_empty "round=$round"
    break
  fi

  if (( run )); then
    if (( parallel > 1 )); then
      n=0
      for id in $ids; do
        left=$(( deadline - $(date +%s) ))
        (( left <= 0 )) && break
        to=$(( left < DISPATCH_TIMEOUT ? left : DISPATCH_TIMEOUT ))
        dispatch_one "$id" "$to" &
        n=$((n + 1))
        if (( n >= parallel )); then wait; n=0; fi
      done
      wait
    else
      for id in $ids; do
        left=$(( deadline - $(date +%s) ))
        (( left <= 0 )) && break
        to=$(( left < DISPATCH_TIMEOUT ? left : DISPATCH_TIMEOUT ))
        dispatch_one "$id" "$to"
      done
    fi
  fi

  if completion_ok; then
    log "目标已完成（证据齐备）"
    event project_completed "round=$round"
    break
  fi
  # 连续多轮图状态无有效变化 → 停机，别把预算烧在空转上
  sig="$(graph_sig)"
  if [[ "$sig" == "$last_sig" ]]; then
    stall=$((stall + 1))
  else
    stall=0
    last_sig="$sig"
  fi
  if (( stall >= ${NUWA_MAX_STALL:-5} )); then
    log "连续 $stall 轮无有效推进（sig=$sig），停机"
    event stall_stop "round=$round" "stall=$stall"
    break
  fi
  (( ! loop )) && break
done

# 收工前修复未完成事务：预留不悬挂到下一轮
if [[ -f "$_PKG_DIR/nuwa/cli.py" ]]; then
  PYTHONPATH="$_PKG_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 "$_PKG_DIR/nuwa/cli.py" \
    recover --root "$PWD" --repair >/dev/null 2>&1 || true
fi

failed=0
[[ -f .nuwa-dispatch-failed ]] && failed=1

# ---------------------------------------------------------------- 战报
log "===== 战报 ====="
sapper status | sed -n '1,12p'
[[ -f "$dir/.sapper/view.url" ]] && log "看板: $(cat "$dir/.sapper/view.url")"
log "继续: cd $dir && nuwa \"$url\" --loop --minutes 60 --parallel 3"
event report_done "rounds=$round"
exit $failed
