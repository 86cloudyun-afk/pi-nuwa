def main(argv: list[str]) -> int:
    args = list(argv)
    store_dir = DEFAULT_STORE
    # 全局 --store 只允许出现在子命令之前（与 argparse 行为一致）
    while args and args[0].startswith("--store"):
        a = args.pop(0)
        if a == "--store":
            if not args:
                usage_error("error: argument --store: expected one argument")
            store_dir = args.pop(0)
        elif a.startswith("--store="):
            store_dir = a.split("=", 1)[1]

    if not args or args[0] in ("-h", "--help"):
        print("usage: sapper [--store DIR] <command> ...")
        print("commands:", ", ".join(sorted(COMMANDS)))
        return 0
    if args[0] == "--version":
        print("sapper 9.9.9-fake")
        return 0

    cmd = args.pop(0)
    fn = COMMANDS.get(cmd)
    if not fn:
        die(f"error: command not found: {cmd}", 2)

    store = Store(Path(store_dir))
    # 所有调用都记账，方便测试断言"nuwa 到底传了什么"
    if cmd not in ("setup", "teardown"):
        store.log_call([cmd] + args)

    try:
        return fn(store, args)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
