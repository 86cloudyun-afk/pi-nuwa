{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "omp/**/*.ts",
    "omp/**/*.d.ts",
    "kb/**/*.ts",
    "core/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "exclude": [
    "archive/**",
    "node_modules/**"
  ]
}
