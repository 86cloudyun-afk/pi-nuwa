# 女娲 v5.0 多阶段零信任安全评估沙盒镜像（base -> lite / full，非 root nuwa 用户）
#
# 构建示例：
#   docker build -f docker/Dockerfile.sandbox -t nuwa-sandbox:latest .
#   docker build -f docker/Dockerfile.sandbox --target lite -t nuwa-sandbox:lite .
#   docker build -f docker/Dockerfile.sandbox --target full -t nuwa-sandbox:full .
FROM alpine:3.20 AS base

LABEL org.opencontainers.image.title="nuwa-sandbox" \
      org.opencontainers.image.description="Nuwa v5.0 multi-stage zero-trust non-root security assessment sandbox" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8

# 安装基础只读评估与诊断工具：ca-certificates / curl / openssl / nmap / python3 / jq / sqlite / netcat-openbsd
RUN apk add --no-cache \
      ca-certificates \
      curl \
      openssl \
      nmap \
      python3 \
      jq \
      sqlite \
      netcat-openbsd \
    && addgroup -g 10001 -S nuwa \
    && adduser -u 10001 -S -G nuwa -h /home/nuwa -s /bin/sh nuwa \
    && mkdir -p /tmp/nuwa /home/nuwa \
    && chown -R nuwa:nuwa /tmp/nuwa /home/nuwa \
    && chmod 0700 /tmp/nuwa /home/nuwa

# 精简只读评估阶段（最小攻击面）
FROM base AS lite

USER nuwa
WORKDIR /tmp/nuwa

CMD ["/bin/sh"]

# 完整评估阶段（补充 git / bash / bind-tools，适配持久 Sidecar 与 DNS/仓库诊断）
FROM base AS full

RUN apk add --no-cache \
      git \
      bash \
      bind-tools

USER nuwa
WORKDIR /tmp/nuwa

CMD ["/bin/sh"]
